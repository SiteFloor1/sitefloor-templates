{#- Line icons for ways of getting here. Expects `mode`. Drawn in currentColor. -#}
<svg class="mi-ico" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if mode == "walk" %}<circle cx="13" cy="4" r="2"/><path d="M10 21l2-6 3 3v3M9 12l2-4 3 1 2 3M11 8l-2 6"/>
{%- elif mode == "bus" %}<rect x="5" y="3" width="14" height="14" rx="2"/><path d="M5 11h14M8 17v3M16 17v3"/><circle cx="8.5" cy="14" r=".8"/><circle cx="15.5" cy="14" r=".8"/>
{%- elif mode == "train" or mode == "tram" %}<rect x="6" y="3" width="12" height="13" rx="3"/><path d="M6 10h12M9 20l-2 2M15 20l2 2M9 16v4h6v-4"/><circle cx="9.5" cy="13" r=".8"/><circle cx="14.5" cy="13" r=".8"/>
{%- elif mode == "car" %}<path d="M4 16v-4l2-5h12l2 5v4M4 16h16M7 16v2M17 16v2M4 12h16"/><circle cx="8" cy="14" r=".8"/><circle cx="16" cy="14" r=".8"/>
{%- elif mode == "bike" %}<circle cx="6" cy="16" r="3.5"/><circle cx="18" cy="16" r="3.5"/><path d="M6 16l4-7h5l3 7M10 9l3 7M14 6h3"/>
{%- elif mode == "parking" %}<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M10 17V8h3a3 3 0 0 1 0 6h-3"/>
{%- else %}<circle cx="12" cy="12" r="8"/>{% endif %}
</svg>
