{#- Elsden header: the name on the left in Cardo, the rooms centred as plain words, "Book a viewing" on the right as
    a text link. On a phone: the name and "Menu"; the bar at the foot keeps the free bays and WhatsApp in reach. -#}
{%- set items = site.nav | navItems(pageId) %}
<header class="nav el-nav">
  <a class="el-name" href="{{ 'index' | href }}" aria-label="{{ site.business.name }}, home">
    {%- if site.brand and site.brand.logo %}<img src="{{ site.brand.logo | img }}" alt="{{ site.business.name }}" height="30">{% else %}{{ site.business.name }}{% endif %}</a>
  <nav class="el-rooms" aria-label="Main">
    {%- for item in items %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
  </nav>
  <a class="el-book" href="{{ site.messages.viewing | book }}"{% if build.booking.whatsapp %} data-wa-text="{{ site.messages.viewing }}"{% endif %} target="_blank" rel="noopener">Book a viewing</a>
  <button class="burger el-burger" type="button" aria-expanded="false" aria-controls="mnav">Menu</button>
</header>
<div class="mnav el-sheet" id="mnav" hidden>
  <nav aria-label="Pages">
    <a href="{{ 'index' | href }}"{% if pageId == "index" %} aria-current="page"{% endif %}>Home</a>
    {%- for item in items %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
  </nav>
  <p class="el-sheet-now" data-live-status><span class="dot" aria-hidden="true"></span> <span data-status-text>Opening hours</span></p>
  <p class="el-sheet-addr">{{ site.location.streetAddress }}, {{ site.location.locality }} {{ site.location.postcode }}</p>
</div>
