{#- Elsden footer: the name in Cardo, the address and how to reach it, the hours, the pages in a row, the credits,
    then the Sitefloor credit. -#}
<footer class="foot el-foot"><div class="el-foot-in">
  <div class="el-foot-a">
    <p class="el-foot-name">{{ site.business.name }}</p>
    <address>{{ site.location.streetAddress }}, {{ site.location.locality }} {{ site.location.postcode }}<br>
      <a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a>{% if site.contact.email %} · <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}</address>
  </div>
  <ul class="el-foot-hours" aria-label="Viewing hours">
    {%- for row in site.hours | hoursRows %}<li data-day="{{ row.dayIndex }}"><span>{{ row.day }}</span> {{ row.label }}</li>{% endfor %}
  </ul>
  <nav class="el-foot-links" aria-label="Footer">
    <a href="{{ 'index' | href }}">Home</a>
    {%- for item in site.nav | navItems(pageId) %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}>{{ item.label }}</a>{% endfor %}
    {%- if "custom-pages" | enabled %}{% for pg in site.pages %}<a href="{{ pg.slug | href }}"{{ "custom-pages" | tierAttr | safe }}>{{ pg.title }}</a>{% endfor %}{% endif %}
    <a href="{{ 'privacy' | href }}">Privacy</a>
  </nav>
  {%- if site.hero.credit %}<p class="el-foot-cr">{{ site.hero.credit }}</p>{% endif %}
  <p class="el-foot-by"><a class="by" href="https://sitefloor.com" rel="noopener">Website by <b>Sitefloor</b></a></p>
</div></footer>
