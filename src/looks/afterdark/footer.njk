{#- After dark footer: the mark small, the address and how to reach the club, today's hours and whether it's open, the
    pages; the Sitefloor credit last. -#}
<footer class="foot ad-foot"><div class="wrap ad-foot-in">
  <div class="ad-foot-name">
    <p class="ad-foot-word">{{ site.business.name }}</p>
    <p class="ad-foot-what">{{ site.hero.title | plain }}</p>
    <p class="ad-foot-now" data-live-status><span class="dot" aria-hidden="true"></span> <span data-status-text>Opening hours</span></p>
  </div>
  <address class="ad-foot-a">{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}<br>
    <a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a>{% if site.contact.email %}<br><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}</address>
  <ul class="ad-foot-hours" aria-label="Opening hours">
    {%- for row in site.hours | hoursRows %}<li data-day="{{ row.dayIndex }}"><span>{{ row.day }}</span> {{ row.label }}</li>{% endfor %}
  </ul>
  <nav class="ad-foot-links" aria-label="Footer">
    <a href="{{ 'index' | href }}">The club</a>
    {%- for item in site.nav | navItems(pageId) %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}>{{ item.label }}</a>{% endfor %}
    <a href="{{ 'privacy' | href }}">Privacy</a>
  </nav>
  <p class="ad-foot-by"><a class="by" href="https://sitefloor.com" rel="noopener">Website by <b>Sitefloor</b></a></p>
</div></footer>
