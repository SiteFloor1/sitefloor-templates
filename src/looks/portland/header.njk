{#- Portland header: the firm's seal and its name in spaced capitals on the left; the pages, the telephone number and
    "Speak to a partner" on the right. On phones, "Menu" opens the pages. -#}
{%- set ini = "" %}{% for w in site.business.name.split(" ") %}{% if w and w[0] == (w[0] | upper) and w[0] != "&" %}{% set ini = ini + w[0] %}{% endif %}{% endfor %}
{%- set speak = ('contact' | href) if ('first-contact' | enabled) else (('#enquiry' if pageId == 'index' else ('index' | href) + '#enquiry') if ('enquiry' | enabled) else 'tel:' + (site.contact.phone | replace(' ', ''))) %}
<header class="nav pt-nav"><div class="wrap pt-nav-in">
  <a class="pt-mark" href="{{ 'index' | href }}" aria-label="{{ site.business.name }}, home">
    <span class="pt-seal" aria-hidden="true">{{ ini | truncate(3, true, "") }}</span>
    {%- if site.brand and site.brand.logo %}<img src="{{ site.brand.logo | img }}" alt="{{ site.business.name }}" height="24">{% else %}<span class="pt-word">{{ site.business.name }}</span>{% endif %}
  </a>
  <nav class="pt-links" aria-label="Main">
    {%- for item in site.nav | navItems(pageId) %}
    <a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>
  <a class="pt-tel" href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone | replace('+44 ', '0') }}</a>
  <a class="pt-speak" href="{{ speak }}">Speak to a partner</a>
  <button class="burger pt-menu" type="button" aria-expanded="false" aria-controls="mnav"><span class="pt-open">Menu</span><span class="pt-close">Close</span></button>
</div></header>
<div class="mnav pt-sheet" id="mnav" hidden>
  <nav aria-label="Pages">
    <a href="{{ 'index' | href }}"{% if pageId == "index" %} aria-current="page"{% endif %}>{{ site.business.name }}</a>
    {%- for item in site.nav | navItems(pageId) %}
    <a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
    <a href="{{ 'complaints' | href }}">Complaints and regulation</a>
  </nav>
  <p class="pt-sheet-now" data-live-status><span class="dot" aria-hidden="true"></span> <span data-status-text>Opening hours</span></p>
  <p class="pt-sheet-addr">{{ site.location.streetAddress }}, {{ site.location.locality }} {{ site.location.postcode }}</p>
</div>
