{#- Nacre "Plan your visit": the discreet way to the door. The live status in one line, the address and journeys as a
    column of labels, each way here as a short itinerary, parking and access as plain notes, then every question.
    Same logic as the shared page; every hook kept. -#}
{%- set v = site.visitInfo %}
{%- set journeys = v.journeys or [] %}
{%- set parking = v.parking or [] %}
{%- set ph = { title: v.title, intro: v.intro, label: v.kicker } %}
{% include "kits/jeweller/partials/page-head.njk" %}

<div data-feature="plan-visit">
<section class="nc-sec nc-arrive"><div class="wrap">
  <p class="nc-label nc-now" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Hours below</span></p>
  <dl class="nc-dl">
    <div><dt>Address</dt><dd>{{ site.location.streetAddress }}, {{ site.location.locality }} {{ site.location.postcode }}</dd></div>
    {%- for j in journeys %}<div><dt>{{ j.from }}</dt><dd>{{ j | boardTime }}</dd></div>{% endfor %}
    {%- for c in parking %}<div><dt>{{ c.name }}</dt><dd data-parking="{{ loop.index0 }}">{% if c.walk is defined %}{{ c.walk }} min walk{% endif %}</dd></div>{% endfor %}
  </dl>
  {%- if site.mode == "demo" %}<p class="nc-fine">Example journeys and parking for a fictional house.</p>
  {%- elif v.checked %}<p class="nc-fine">Checked with {{ site.business.name }} in {{ v.checked | checkedText }}. Driving times are outside rush hour.</p>{% endif %}
</div></section>

{%- if journeys.length %}
<section class="nc-sec nc-ways" aria-labelledby="pv-j-h"><div class="wrap">
  <h2 class="nc-h3" id="pv-j-h">The way here</h2>
  <div class="nc-chips" role="tablist" aria-label="Ways to get here" data-pv-tabs hidden>
    {%- for j in journeys %}
    <button type="button" role="tab" id="pv-tab-{{ loop.index0 }}" aria-controls="pv-panel-{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">{{ (j.mode | modeWords).tab }}</button>
    {%- endfor %}
  </div>
  {%- for j in journeys %}
  <div class="nc-way rv" id="pv-panel-{{ loop.index0 }}" data-pv-panel>
    <p class="nc-way-h"><b>{{ j.from }}</b>{% if j.stop %}, get off at {{ j.stop }}{% endif %} <span class="nc-label nc-muted">{% if (j.mode | modeWords).about %}about {% endif %}{{ j.minutes }} min {{ (j.mode | modeWords).verb }}</span></p>
    <ol class="nc-steps-s">
      {%- for step in j.steps %}<li>{{ step }}</li>{% endfor %}
      <li><b>{{ site.business.name }}</b>, {{ site.location.streetAddress }}</li>
    </ol>
    <a class="nc-u nc-label" href="{{ j | directionsFor }}" target="_blank" rel="noopener">Directions in Google Maps</a>
  </div>
  {%- endfor %}
  <div class="nc-leave" data-pv-leave hidden>
    <label class="nc-label" for="pv-appt">Your appointment time. We'll say when to leave.</label>
    <input class="nc-in nc-in-s" type="time" id="pv-appt" step="900" data-pv-appt>
    <ul class="nc-list" data-pv-leave-list aria-live="polite"></ul>
  </div>
</div></section>
{%- endif %}

{%- if parking.length or v.access or v.payment %}
<section class="nc-sec nc-notes"><div class="wrap">
  {%- if parking.length %}
  <div><h2 class="nc-h3">Parking</h2>
    {%- for c in parking %}
    <div class="nc-note rv">
      <h3 class="nc-label">{{ c.name }}</h3>
      <p class="nc-fine" data-parking-card="{{ loop.index0 }}" hidden></p>
      <p class="nc-body">{{ c | parkingSummary }}</p>
      <p class="nc-fine">{% if c.walk is defined %}{{ c.walk }} min walk{% endif %}{% if c.walk is defined and c.price %} · {% endif %}{{ c.price }}</p>
      {%- if c.note %}<p class="nc-fine">{{ c.note }}</p>{% endif %}
    </div>
    {%- endfor %}
  </div>
  {%- endif %}
  <div>
    {%- if v.access %}<h2 class="nc-h3">Access</h2>
    <ul class="nc-list">{% for a in v.access %}<li class="{{ 'yes' if a.yes else 'no' }}"><span class="sr-only">{{ "Yes:" if a.yes else "No:" }}</span>{{ a.label }}</li>{% endfor %}</ul>
    {%- if v.accessNote %}<p class="nc-fine">{{ v.accessNote }}</p>{% endif %}{% endif %}
    {%- if v.payment %}<h2 class="nc-h3">Paying</h2><p class="nc-body">{{ v.payment }}</p>{% endif %}
  </div>
</div></section>
{%- endif %}
</div>

{#- The house's other sections (the room, your visit, reviews…) live here rather than on the home page (look.json →
    visitOrder); the questions are listed in full below. -#}
{%- for id in site.look | visitOrder %}{% if id != "questions" and (id | enabled) and not (homeParts.elsewhere[id] and (homeParts.elsewhere[id] | enabled)) %}{% include homeParts.paths[id] %}{% endif %}{% endfor %}
{%- set visitHeading = false %}
{% include "features/visit/visit.njk" %}
{%- set groups = site | questionTopics %}
{%- if groups.length %}
<section class="nc-sec nc-qa" id="questions"><div class="wrap">
  <h2 class="nc-h3">Questions</h2>
  {%- for g in groups %}
  <h3 class="nc-label nc-muted nc-qa-topic">{{ g.topic }}</h3>
  <dl class="nc-qa-dl">{% for item in g.items %}<div><dt>{{ item.q }}</dt><dd>{{ item.a }}</dd></div>{% endfor %}</dl>
  {%- endfor %}
</div></section>
{%- endif %}
