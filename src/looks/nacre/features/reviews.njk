{#- Nacre reviews: one at a time, very large and light, as if said across the tray; the name and month beneath as a
    label; the stars small. The others follow, smaller, in a quiet column. -#}
{%- set sec = { title: site.sections.reviews.title, intro: site.sections.reviews.intro } %}
<section id="reviews" class="nc-sec nc-rev" data-feature="reviews"{{ "reviews" | tierAttr | safe }}><div class="wrap">
  {% include "core/partials/section-head.njk" %}
  <div class="nc-rev-in">
    {%- for r in site.reviews.items %}
    <figure class="rev rv{% if loop.first %} nc-rev-1{% endif %}">
      <blockquote><p>{{ r.text }}</p></blockquote>
      <figcaption class="nc-label nc-muted">{{ r.author }} · {{ r.date | monthYear }} <span class="st"><span aria-hidden="true">{{ r.rating | stars }}</span><span class="sr-only">Rated {{ r.rating }} out of 5</span></span></figcaption>
    </figure>
    {%- endfor %}
  </div>
  {%- if site.reviews.source == "sample" %}<p class="nc-fine">Sample reviews for the demo. On a live site these are the house's own Google reviews, with the name and month.</p>{% endif %}
</div></section>
