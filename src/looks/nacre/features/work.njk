{#- Nacre archive: every photograph on pearl, three across with wide margins; a quiet enlarged view. -#}
{%- set g = site.gallery %}
{%- set ph = { title: site.work.title, intro: site.work.intro, label: site.work.kicker } %}
{% include "kits/jeweller/partials/page-head.njk" %}
<section class="nc-sec nc-arch" data-feature="gallery" data-gallery-page><div class="wrap">
  <div class="nc-arch-bar">
    <div class="nc-chips" role="group" aria-label="Show photographs of" data-gallery-chips hidden>
      <button type="button" aria-pressed="true" data-tag="">Everything</button>
      {%- for f in g.filters or [] %}<button type="button" aria-pressed="false" data-tag="{{ f.tag }}">{{ f.label }}</button>{% endfor %}
    </div>
    <p class="nc-label nc-muted" data-gallery-count role="status"></p>
  </div>
  {% set galleryPage = true %}{% include "features/gallery/gallery-list.njk" %}
  <p class="nc-acts">
    <button type="button" class="nc-u nc-label nc-btnlink" data-gallery-more hidden>More photographs</button>
    {%- if g.profile %}<a class="nc-u nc-label" href="{{ g.profile }}" target="_blank" rel="noopener" data-gallery-end hidden>The rest are on Instagram</a>{% endif %}
  </p>
  <span class="work-sentinel" data-gallery-sentinel aria-hidden="true"></span>
</div></section>
<dialog class="nc-lb" data-gallery-dialog aria-label="Photograph">
  <figure><img data-lb-img alt=""><figcaption class="nc-label" data-lb-cap></figcaption></figure>
  <div class="nc-lb-bar">
    <button type="button" class="nc-label nc-btnlink" data-lb-prev aria-label="Previous photograph">Previous</button>
    <button type="button" class="nc-label nc-btnlink" data-lb-next aria-label="Next photograph">Next</button>
    <a class="nc-u nc-label" data-lb-book target="_blank" rel="noopener">Ask about this piece</a>
    <a class="nc-label" data-lb-link target="_blank" rel="noopener" hidden>On Instagram</a>
    <button type="button" class="nc-label nc-btnlink" data-lb-close aria-label="Close">Close</button>
  </div>
</dialog>
