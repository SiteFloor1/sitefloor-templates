{#- Nacre season line: one centred line of small capitals on mist, above the header. -#}
<div class="seasons nc-season" data-feature="seasonal">
  {%- for s in site.seasons %}
  <p class="season" data-from="{{ s.from }}" data-to="{{ s.to }}" data-tint="{{ s.tint or '' }}"{% if loop.index0 != build.seasonIndex %} hidden{% endif %}>
    <span>{{ s.banner }}</span>{% if s.link %} <a href="{{ s.link.href }}">{{ s.link.label }}</a>{% endif %}
  </p>
  {%- endfor %}
</div>
