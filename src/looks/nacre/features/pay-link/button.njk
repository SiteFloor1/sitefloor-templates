{#- Nacre Payment Link inside a feature: one underlined line and a small note. Set `pay` (and `payLabel`) first. -#}
{%- if site.payLinks and ("pay-link" | enabled) %}{% for pl in site.payLinks.items %}{% if pl.id == pay %}
<span class="pl-wrap nc-paywrap"{{ "pay-link" | tierAttr | safe }}>
  <a class="nc-u nc-label pl-btn" href="{{ pl.url }}" target="_blank" rel="noopener" data-feature="pay-link" data-pay="{{ pl.id }}"{% if pl.holds == "request" %} data-pay-url="{{ pl.url }}"{% endif %}>{{ payLabel or (("Pay the " + (pl.amount | pounds) + " deposit" + (" to hold your request" if pl.holds == "request" else "")) if pl.kind == "deposit" else ("Pay " + (pl.amount | pounds) + (" a month" if pl.kind == "monthly" else ""))) }}</a>
  <small class="pl-on nc-fine">Paid on Stripe's own secure page{% if pl.holds == "request" %} · Holds your request; {{ site.business.name }} confirms with you. It isn't a booking until they do.{% endif %}{% if pl.for %} · {{ pl.for }}{% endif %}</small>
</span>
{%- endif %}{% endfor %}{% endif %}
