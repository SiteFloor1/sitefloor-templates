{#- Nacre general page (The house): text in a narrow light column, photographs very large between, with silence. -#}
{%- set ph = { title: cp.title, intro: cp.intro, label: cp.kicker } %}
{% include "kits/jeweller/partials/page-head.njk" %}
<div class="nc-cp" data-feature="custom-pages">
  {%- for b in cp.blocks %}
  {%- if b.type == "text" %}
  <section class="wrap nc-cp-t rv">
    {%- if b.heading %}<h2 class="nc-h3">{{ b.heading }}</h2>{% endif %}
    <div>{%- for para in b.body | paragraphs %}<p>{{ para }}</p>{% endfor %}</div>
  </section>
  {%- elif b.type == "photo" %}
  <figure class="nc-cp-p rv{% if loop.index0 % 2 %} nc-cp-p-r{% endif %}"><img src="{{ b.src | img }}" alt="{{ b.alt }}" loading="lazy" decoding="async">{% if b.caption %}<figcaption class="nc-label nc-muted">{{ b.caption }}</figcaption>{% endif %}</figure>
  {%- elif b.type == "list" %}
  <section class="wrap nc-cp-t rv">
    {%- if b.heading %}<h2 class="nc-h3">{{ b.heading }}</h2>{% endif %}
    <ul class="nc-list">{% for item in b.items %}<li>{{ item }}</li>{% endfor %}</ul>
  </section>
  {%- elif b.type == "book" %}
  <p class="wrap nc-cp-o rv"><span class="nc-body">{{ b.text }}</span> <a class="nc-u nc-label" href="{{ (site.messages.appointment or site.messages.general) | book }}"{% if build.booking.whatsapp %} data-wa-text="{{ site.messages.appointment or site.messages.general }}"{% endif %} target="_blank" rel="noopener">{{ b.label or "Request a private appointment" }}</a></p>
  {%- endif %}
  {%- endfor %}
</div>
