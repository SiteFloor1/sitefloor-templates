{#- Nacre visit: the address set like a card on the tray, the week's hours as a column of labels with today marked,
    the live status as one line, and directions underlined. -#}
{%- set sec = { title: site.sections.visit.title, intro: site.sections.visit.intro } %}
<section id="visit" class="nc-sec nc-visit" data-feature="visit"><div class="wrap">
  {%- if visitHeading == false %}<h2 class="nc-h3">Opening hours</h2>{% else %}{% include "core/partials/section-head.njk" %}{% endif %}
  <div class="nc-visit-in">
    <div class="nc-visit-a rv">
      <p class="nc-visit-addr">{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}</p>
      {%- if site.location.area %}<p class="nc-body">{{ site.location.area }}</p>{% endif %}
      <a class="nc-u nc-label" href="{{ site.location | directions }}" target="_blank" rel="noopener">Directions</a>
    </div>
    <div class="nc-visit-h rv" data-hours>
      <p class="nc-label nc-now" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Opening hours</span></p>
      <p class="nc-fine" data-status-detail></p>
      <table class="nc-hrs">
        <caption class="sr-only">Opening hours</caption>
        <tbody>{% for row in site.hours | hoursRows %}<tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>{% endfor %}</tbody>
      </table>
      {%- set upcoming = site.hours | upcomingExceptions(build.today) %}
      {%- if upcoming.length %}<ul class="nc-ex">{% for ex in upcoming %}<li><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </div>
</div></section>
