{#- The atelier wall, the week: a ruled list of days, today marked by the shared script (tr[data-day]); closures coming
    up follow as one line. -#}
<table class="cp-week" data-hours>
  <caption class="sr-only">Opening hours</caption>
  <tbody>{% for row in site.hours | hoursRows %}<tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>{% endfor %}</tbody>
</table>
{%- set upcoming = site.hours | upcomingExceptions(build.today) %}
{%- if upcoming.length %}<p class="cp-week-ex">{% for ex in upcoming %}<span><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</span>{% endfor %}</p>{% endif %}
