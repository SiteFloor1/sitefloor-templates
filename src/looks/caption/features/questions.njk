{#- The atelier wall, questions: a ruled list, each question in the italic with its answer beneath; two quiet links
    close it. -#}
{%- set sec = site.sections.questions %}
{%- set qs = site | homeQuestions %}
<section id="questions" class="cp-qa" data-feature="questions"{{ "questions" | tierAttr | safe }}><div class="wrap">
  {% include "core/partials/section-head.njk" %}
  <dl class="cp-qa-list">
    {%- for item in qs %}<div><dt>{{ item.q }}</dt><dd>{{ item.a }}</dd></div>{% endfor %}
  </dl>
  <p class="cp-acts">
    {%- if "plan-visit" | enabled and pageId != "visit" %}<a class="cp-link" href="{{ 'visit' | href }}"{{ "plan-visit" | tierAttr | safe }}>Every question, and finding us</a>{% endif %}
    <a class="cp-link" href="{{ site.messages.general | wa }}" data-wa-text="{{ site.messages.general }}" target="_blank" rel="noopener">Ask us anything else</a>
  </p>
</div></section>
