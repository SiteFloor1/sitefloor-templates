{#- Cacao visit: the address large, then the week's hours with today marked, the live status, and directions. -#}
{%- set sec = { kicker: "", title: site.sections.visit.title, intro: site.sections.visit.intro } %}
<section id="visit" class="sec-visit cc-visit" data-feature="visit"><div class="wrap">
  {%- if visitHeading == false %}<h2 class="cc-h cc-h-s">Opening hours</h2>{% else %}{% include "core/partials/section-head.njk" %}{% endif %}
  <div class="cc-visit-in">
    <div class="cc-addr">
      <p class="cc-addr-l">{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}</p>
      {%- if site.location.area %}<p class="cc-addr-s">{{ site.location.area }}</p>{% endif %}
      <a class="go" href="{{ site.location | directions }}" target="_blank" rel="noopener">Directions</a>
    </div>
    <div class="cc-hours" data-hours>
      <p class="cc-now" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Opening hours</span></p>
      <p class="cc-sub" data-status-detail></p>
      <table class="cc-hrs">
        <caption class="sr-only">Opening hours</caption>
        <tbody>{% for row in site.hours | hoursRows %}<tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>{% endfor %}</tbody>
      </table>
      {%- set upcoming = site.hours | upcomingExceptions(build.today) %}
      {%- if upcoming.length %}<ul class="cc-ex">{% for ex in upcoming %}<li><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </div>
</div></section>
