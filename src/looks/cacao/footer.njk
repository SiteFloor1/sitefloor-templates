{#- Cacao footer: the seal large, the shop's name and address set like the base of the box, the week's hours, the pages;
    the Sitefloor credit last. -#}
<footer class="foot cc-foot"><div class="wrap cc-foot-in">
  <div class="cc-foot-seal">{% set sealId = "f" %}{% include "looks/cacao/parts/seal.njk" %}</div>
  <div class="cc-foot-a">
    <p class="cc-foot-name">{{ site.business.name }}</p>
    <address>{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}<br>
      <a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a>{% if site.contact.email %}<br><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}</address>
  </div>
  <ul class="cc-foot-hours" aria-label="Opening hours">
    {%- for row in site.hours | hoursRows %}<li data-day="{{ row.dayIndex }}"><span>{{ row.day }}</span> {{ row.label }}</li>{% endfor %}
  </ul>
  <nav class="cc-foot-links" aria-label="Footer">
    <a href="{{ 'index' | href }}">The counter</a>
    {%- for item in site.nav | navItems(pageId) %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}>{{ item.label }}</a>{% endfor %}
    <a href="{{ 'privacy' | href }}">Privacy</a>
  </nav>
  <p class="cc-foot-by"><a class="by" href="https://sitefloor.com" rel="noopener">Website by <b>Sitefloor</b></a></p>
</div></footer>
