{#- Blue hour work: the photographs as a lit wall, one large and two beside it, repeating; each frame numbered in
    engraved capitals with its caption under it. Filters are square keys with a light; the enlarged view is the
    photograph alone on the deep blue with its number. -#}
{%- set g = site.gallery %}
{%- set ph = { kicker: site.work.kicker, title: site.work.title, intro: site.work.intro } %}
{% include "kits/electrician/partials/page-head.njk" %}
<section class="bh-wall-sec" data-feature="gallery" data-gallery-page><div class="wrap">
  <div class="bh-keys" role="group" aria-label="Show work by" data-gallery-chips hidden>
    <button type="button" aria-pressed="true" data-tag=""><span class="bh-led" aria-hidden="true"></span>Everything</button>
    {%- for f in g.filters or [] %}<button type="button" aria-pressed="false" data-tag="{{ f.tag }}"><span class="bh-led" aria-hidden="true"></span>{{ f.label }}</button>{% endfor %}
    <p class="bh-keys-n" data-gallery-count role="status"></p>
  </div>
  <div class="bh-wall">{% set galleryPage = true %}{% include "features/gallery/gallery-list.njk" %}</div>
  <p class="bh-wall-more">
    <button type="button" class="bh-under bh-linkbtn" data-gallery-more hidden>More photographs</button>
    {%- if g.profile %}<a class="bh-under" href="{{ g.profile }}" target="_blank" rel="noopener" data-gallery-end hidden>The rest are on Instagram</a>{% endif %}
  </p>
  <span class="work-sentinel" data-gallery-sentinel aria-hidden="true"></span>
</div></section>
<dialog class="bh-lb" data-gallery-dialog aria-label="Photo">
  <figure><img data-lb-img alt=""><figcaption data-lb-cap></figcaption></figure>
  <div class="bh-lb-bar">
    <button type="button" class="bh-linkbtn" data-lb-prev aria-label="Previous photo">Previous</button>
    <button type="button" class="bh-linkbtn" data-lb-next aria-label="Next photo">Next</button>
    <a class="go" data-lb-book target="_blank" rel="noopener">{{ "Ask about this" if build.booking.whatsapp else build.booking.label }}</a>
    <a class="bh-linkbtn" data-lb-link target="_blank" rel="noopener" hidden>On Instagram</a>
    <button type="button" class="bh-linkbtn" data-lb-close aria-label="Close">Close</button>
  </div>
</dialog>
