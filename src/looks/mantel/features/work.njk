{#- Mantel "contact sheet": every photograph from the studio's feed in an even sheet with its caption beneath, filters as
    words in one line, the count at the end of it; the enlarged view is a plain white mount. gallery.js drives it. -#}
{%- set g = site.gallery %}
{%- set ph = { kicker: site.work.kicker, title: site.work.title, intro: site.work.intro } %}
{% include "kits/florist/partials/page-head.njk" %}
<section class="mt-sheet-sec" data-feature="gallery" data-gallery-page><div class="wrap">
  <div class="mt-sheet-bar">
    <div class="mt-words" role="group" aria-label="Show photographs of" data-gallery-chips hidden>
      <button type="button" aria-pressed="true" data-tag="">Everything</button>
      {%- for f in g.filters or [] %}<button type="button" aria-pressed="false" data-tag="{{ f.tag }}">{{ f.label }}</button>{% endfor %}
    </div>
    <p class="mt-fine" data-gallery-count role="status"></p>
  </div>
  {% set galleryPage = true %}{% include "features/gallery/gallery-list.njk" %}
  <p class="mt-sheet-more">
    <button type="button" class="fl-btn" data-gallery-more hidden>More photographs</button>
    {%- if g.profile %}<a class="fl-link" href="{{ g.profile }}" target="_blank" rel="noopener" data-gallery-end hidden>The rest are on Instagram</a>{% endif %}
  </p>
  <span class="work-sentinel" data-gallery-sentinel aria-hidden="true"></span>
  {%- if site.mode == "demo" %}<p class="mt-fine">Stock photographs in this demo; a live site shows the studio's own Instagram.</p>{% endif %}
</div></section>
<dialog class="lb mt-lb" data-gallery-dialog aria-label="Photograph">
  <div class="lb-in">
    <figure class="lb-fig"><img data-lb-img alt=""><figcaption data-lb-cap></figcaption></figure>
    <div class="lb-bar">
      <button type="button" class="lb-nav" data-lb-prev aria-label="Previous photograph">←</button>
      <button type="button" class="lb-nav" data-lb-next aria-label="Next photograph">→</button>
      <a class="fl-btn" data-lb-book target="_blank" rel="noopener">Ask for something like this</a>
      <a class="fl-link" data-lb-link target="_blank" rel="noopener" hidden>On Instagram</a>
      <button type="button" class="lb-close" data-lb-close aria-label="Close">×</button>
    </div>
  </div>
</dialog>
