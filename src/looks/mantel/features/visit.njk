{#- Mantel hours: the week as a ruled list in the serif, today marked with a square in the week's colour; the
    studio's card (the seal, the address) beside it. Keeps the live-status hooks. -#}
<section id="visit" class="mt-hours" data-feature="visit"><div class="wrap mt-hours-in">
  <div data-hours>
    <h2 class="mt-k">{{ "Opening hours" if visitHeading == false else site.sections.visit.title }}</h2>
    <p class="mt-door-now" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Opening hours</span></p>
    <p class="mt-fine" data-status-detail></p>
    <table class="mt-hrs">
      <caption class="sr-only">Opening hours</caption>
      <tbody>{% for row in site.hours | hoursRows %}<tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>{% endfor %}</tbody>
    </table>
    {%- set upcoming = site.hours | upcomingExceptions(build.today) %}
    {%- if upcoming.length %}<ul class="mt-exc">{% for ex in upcoming %}<li><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</li>{% endfor %}</ul>{% endif %}
  </div>
  <address class="mt-card">
    {%- set sealClass = "mt-seal-big" %}{% include "looks/mantel/parts/seal.njk" %}
    <b>{{ site.business.name }}</b>{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}
    <a class="fl-link" href="{{ site.location | directions }}" target="_blank" rel="noopener">Directions</a>
  </address>
</div></section>
