{#- Mantel footer: the seal large, the studio's address and hours, the delivery days, the pages; the Sitefloor credit last. -#}
<footer class="foot mt-foot"><div class="wrap mt-foot-in">
  <a class="mt-foot-mark" href="{{ 'index' | href }}" aria-label="{{ site.business.name }}, home">{% set sealClass = "mt-seal-big" %}{% include "looks/mantel/parts/seal.njk" %}</a>
  <address class="mt-foot-a"><b>{{ site.business.name }}</b><br>{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}<br>
    <a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a>{% if site.contact.email %}<br><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}</address>
  <div class="mt-foot-h">
    <p><b>The studio</b></p>
    <ul aria-label="Opening hours">{%- for g in site.hours | hoursGroups %}<li><span>{{ g.days }}</span> {{ g.label }}</li>{% endfor %}</ul>
    {%- if site.delivery %}<p class="mt-foot-d"><b>Same-day delivery</b><br>{{ site.delivery.cutoffs | cutoffGroups }}</p>{% endif %}
  </div>
  <nav class="mt-foot-l" aria-label="Footer">
    {%- for item in site.nav | navItems(pageId) %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}>{{ item.label }}</a>{% endfor %}
    {%- include "looks/mantel/parts/more-pages.njk" %}
    {%- if "custom-pages" | enabled %}{% for pg in site.pages %}<a href="{{ pg.slug | href }}"{{ 'custom-pages' | tierAttr | safe }}>{{ pg.kicker }}</a>{% endfor %}{% endif %}
    <a href="{{ 'privacy' | href }}">Privacy</a>
  </nav>
  <p class="mt-foot-by"><a class="by" href="https://sitefloor.com" rel="noopener">Website by <b>Sitefloor</b></a></p>
</div></footer>
