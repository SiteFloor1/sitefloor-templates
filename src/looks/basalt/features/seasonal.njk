{#- Basalt season line: one thin line above the header, the season's name in bone, its words in ash. -#}
<div class="seasons bs-season" data-feature="seasonal">
  {%- for s in site.seasons %}
  <p class="season" data-from="{{ s.from }}" data-to="{{ s.to }}" data-tint="{{ s.tint or '' }}"{% if loop.index0 != build.seasonIndex %} hidden{% endif %}>
    <b>{{ s.name }}</b> <span>{{ s.banner }}</span>{% if s.link %} <a href="{{ s.link.href }}">{{ s.link.label }}</a>{% endif %}
  </p>
  {%- endfor %}
</div>
