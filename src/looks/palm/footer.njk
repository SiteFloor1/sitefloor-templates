{#- Palm footer: a letterhead. The name in the display face over a short gold rule, the address and how to reach the
    clinic on one centred line, the week's hours beneath, the pages in a row, then the Sitefloor credit. -#}
<footer class="foot pm-foot"><div class="wrap pm-foot-in">
  <p class="pm-foot-word">{{ site.business.name }}</p>
  <p class="pm-foot-k">{{ site.hero.kicker }}</p>
  <address class="pm-foot-a">{{ site.location.streetAddress }}, {{ site.location.locality }} {{ site.location.postcode }}<span aria-hidden="true"> · </span><br class="pm-br">
    <a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a>{% if site.contact.email %}<span aria-hidden="true"> · </span><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}</address>
  <ul class="pm-foot-hours" aria-label="Opening hours">
    {%- for row in site.hours | hoursRows %}<li data-day="{{ row.dayIndex }}"><span>{{ row.day }}</span> {{ row.label }}</li>{% endfor %}
  </ul>
  <nav class="pm-foot-links" aria-label="Footer">
    <a href="{{ 'index' | href }}">Home</a>
    {%- for item in site.nav | navItems(pageId) %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}>{{ item.label }}</a>{% endfor %}
    <a href="{{ 'privacy' | href }}">Privacy</a>
  </nav>
  <p class="pm-foot-by"><a class="by" href="https://sitefloor.com" rel="noopener">Website by <b>Sitefloor</b></a></p>
</div></footer>
