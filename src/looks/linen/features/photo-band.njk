{#- Linen: one photograph across the width, still; its line beneath on a rule, not over the picture. -#}
{%- set p = site.photoBand %}
<section class="lpb" data-feature="photo-band"{{ "photo-band" | tierAttr | safe }} aria-label="{{ p.kicker }}">
  <picture>
    {%- if p.srcMobile %}<source media="(max-width:700px)" srcset="{{ p.srcMobile | img }}">{% endif %}
    <img src="{{ p.src | img }}" alt="{{ p.alt }}" loading="lazy" decoding="async" width="{{ p.width }}" height="{{ p.height }}">
  </picture>
  <div class="wrap lpb-cap"><span>{{ p.kicker }}</span><p>{{ p.caption }}</p></div>
</section>
