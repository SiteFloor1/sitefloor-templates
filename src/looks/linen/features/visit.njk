{#- Linen: the week's hours as a ledger (today marked by the shared script) beside the address and the way in. -#}
{%- set sec = { title: site.sections.visit.title, intro: site.location.area } %}
<section id="visit" class="lv" data-feature="visit"><div class="wrap lv-in">
  <div class="lv-intro">
    {%- if visitHeading == false %}<h2>Opening hours</h2>{% else %}<h2>{{ sec.title | markup | safe }}</h2>{% endif %}
    <p>{{ sec.intro }}</p>
    <address><b>{{ site.business.name }}</b><br>{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}</address>
    <p><a class="go" href="{{ site.location | directions }}" target="_blank" rel="noopener">Open in Google Maps</a></p>
  </div>
  <div class="lv-hours" data-hours>
    <p class="lv-now" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Opening hours</span></p>
    <p class="lv-sub" data-status-detail></p>
    <table class="lv-t"><caption class="sr-only">Opening hours</caption><tbody>
      {%- for row in site.hours | hoursRows %}<tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>{% endfor %}
    </tbody></table>
    {%- set upcoming = site.hours | upcomingExceptions(build.today) %}
    {%- if upcoming.length %}<ul class="lv-ex">{% for ex in upcoming %}<li><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</li>{% endfor %}</ul>{% endif %}
  </div>
</div></section>
