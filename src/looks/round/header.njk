{#- The round, header: the emblem (two rings, the Hall from above) and the name on the left; "Trial class" underlined in
    the accent and "Menu" on the right. No row of links: every page is on the menu sheet and at the foot of the hero. -#}
{%- set trialMsg = (site.classes.message | trialText(null)) if site.classes else site.messages.general %}
<header class="nav rd-nav"><div class="wrap rd-nav-in">
  <a class="rd-mark" href="{{ 'index' | href }}" aria-label="{{ site.business.name }}, home">
    {%- if site.brand and site.brand.logo %}<img src="{{ site.brand.logo | img }}" alt="{{ site.business.name }}" height="34">
    {%- else %}<svg viewBox="0 0 34 34" aria-hidden="true" focusable="false"><circle cx="17" cy="17" r="16" fill="none" stroke="currentColor" class="rd-ring-a"/><circle cx="17" cy="17" r="11" fill="none" stroke="currentColor" stroke-width=".8"/><path d="M11 13l3 9 3-6 3 6 3-9" fill="none" stroke="currentColor" stroke-width="1.2"/></svg><span>{{ site.business.name }}</span>{% endif %}</a>
  <a class="rd-top-trial" href="{{ trialMsg | book }}"{% if build.booking.whatsapp %} data-wa-text="{{ trialMsg }}"{% endif %} target="_blank" rel="noopener">Trial class</a>
  <button class="burger rd-menu" type="button" aria-expanded="false" aria-controls="mnav"><span class="rd-open">Menu</span><span class="rd-close">Close</span></button>
</div></header>
<div class="mnav rd-sheet" id="mnav" hidden><div class="wrap rd-sheet-in">
  <nav aria-label="Pages">
    <a href="{{ 'index' | href }}"{% if pageId == "index" %} aria-current="page"{% endif %}>Home</a>
    {%- for item in site.nav | navItems(pageId) %}
    <a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>
  <div class="rd-sheet-side">
    <p class="rd-now" data-live-status><span class="dot" aria-hidden="true"></span> <span data-status-text>Studio hours</span></p>
    <address>{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}</address>
    <a class="rd-link" href="{{ site.messages.general | book }}"{% if build.booking.whatsapp %} data-wa-text="{{ site.messages.general }}"{% endif %} target="_blank" rel="noopener">{{ "WhatsApp the school" if build.booking.whatsapp else build.booking.label }}</a>
  </div>
</div></div>
