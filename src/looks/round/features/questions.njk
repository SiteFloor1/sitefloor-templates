{#- The round, questions: each question in weight on its own line, the answer beneath it in the reading weight, numbered
    in the margin in the accent. No accordion. Two quiet links after. -#}
{%- set sec = site.sections.questions %}
{%- set qs = site | homeQuestions %}
<section id="questions" class="rd-qa" data-feature="questions"{{ "questions" | tierAttr | safe }}><div class="wrap rd-qa-in">
  {% include "core/partials/section-head.njk" %}
  <ol class="rd-qa-list">
    {%- for item in qs %}<li class="rv"><h3>{{ item.q }}</h3><p>{{ item.a }}</p></li>{% endfor %}
  </ol>
  <p class="rd-acts">
    {%- if "plan-visit" | enabled and pageId != "visit" %}<a class="rd-link" href="{{ 'visit' | href }}"{{ "plan-visit" | tierAttr | safe }}>Every question, and the studio</a>{% endif %}
    <a class="rd-link" href="{{ site.messages.general | wa }}" data-wa-text="{{ site.messages.general }}" target="_blank" rel="noopener">Ask us anything else</a>
  </p>
</div></section>
