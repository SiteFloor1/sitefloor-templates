{#- The round, visit: the studio's address in a circle (the hours' live status inside it); the week beside it as a ruled
    list with today marked. On Plan your visit only the week shows. -#}
{%- set sec = { title: site.sections.visit.title, intro: site.sections.visit.intro } %}
<section id="visit" class="rd-v" data-feature="visit"><div class="wrap">
  {%- if visitHeading == false %}<h2 class="rd-h2">Studio hours</h2>{% else %}{% include "core/partials/section-head.njk" %}{% endif %}
  <div class="rd-v-in{% if visitHeading == false %} rd-v-only{% endif %}">
    {%- if visitHeading != false %}
    <div class="rd-v-disc rv">
      <address>{{ site.location.streetAddress }}<br>{{ site.location.locality }}<br><b>{{ site.location.postcode }}</b></address>
      {%- if site.location.area %}<p class="rd-fine">{{ site.location.area }}</p>{% endif %}
      <a class="rd-link" href="{{ site.location | directions }}" target="_blank" rel="noopener">Directions</a>
    </div>
    {%- endif %}
    <div class="rd-v-week rv" data-hours>
      <p class="rd-now" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Studio hours</span></p>
      <p class="rd-fine" data-status-detail></p>
      <table class="rd-v-days">
        <caption class="sr-only">Studio hours</caption>
        <tbody>{% for row in site.hours | hoursRows %}<tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>{% endfor %}</tbody>
      </table>
      {%- set upcoming = site.hours | upcomingExceptions(build.today) %}
      {%- if upcoming.length %}<ul class="rd-v-ex">{% for ex in upcoming %}<li><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </div>
</div></section>
