{#- Salon: finding us. The address large, the hours as a quiet table, open now, and directions. -#}
<section id="visit" class="sec-visit sa-visit" data-feature="visit" aria-labelledby="sa-visit-h"><div class="wrap sa-visit-grid">
  <div>
    <h2 id="sa-visit-h">{{ site.sections.visit.title | markup | safe }}</h2>
    <address class="sa-visit-ad">{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}</address>
    {%- if site.location.area %}<p class="sa-visit-area">{{ site.location.area }}</p>{% endif %}
    <a class="sa-send" href="{{ site.location | directions }}" target="_blank" rel="noopener">Directions</a>
  </div>
  <div data-hours>
    <p class="sa-st" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Opening hours</span></p>
    <p class="sa-small" data-status-detail></p>
    <table class="sa-hours">
      <caption class="sr-only">Opening hours</caption>
      <tbody>{% for row in site.hours | hoursRows %}<tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>{% endfor %}</tbody>
    </table>
    {%- set upcoming = site.hours | upcomingExceptions(build.today) %}
    {%- if upcoming.length %}<ul class="sa-ex">{% for ex in upcoming %}<li><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</li>{% endfor %}</ul>{% endif %}
  </div>
</div></section>
