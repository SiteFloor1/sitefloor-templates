{#- Quail team: a ledger, one technician to a ruled row: a square of their work, the name in italic, and their card
    as a short specification (days, years, known for), with Book in the house's own chip. -#}
{%- set ph = { kicker: site.team.kicker, title: site.team.title, intro: site.team.intro } %}
{% include "kits/nails/partials/page-head.njk" %}
<div class="wrap ql-led" data-feature="team">
  {%- if site.team.filters %}
  <div class="ql-tabs">
    <div role="group" aria-label="{{ site.team.filtersLabel or 'Who is best for' }}" data-team-chips>
      <button type="button" aria-pressed="true" data-tag="">Everyone</button>
      {%- for f in site.team.filters %}<button type="button" aria-pressed="false" data-tag="{{ f.tag }}">{{ f.label }}</button>{% endfor %}
    </div>
    <p class="ql-tabs-n" data-team-count role="status"></p>
  </div>
  {%- endif %}
  <ol class="ql-led-list">
  {%- for s in site.staff %}
  <li><article class="ql-led-row rv" id="{{ s.name | slug }}" data-tags="{{ (s.tags or []) | join(' ') }}">
    {%- if s.photo %}<img class="ql-led-img" src="{{ s.photo | img }}" alt="Recent work by {{ s.name }}" loading="{{ 'eager' if loop.first else 'lazy' }}" decoding="async" width="720" height="900">{% endif %}
    <div class="ql-led-who">
      <h2 class="ql-led-name">{{ s.name }}</h2>
      <p class="ql-led-role">{{ s.role }}</p>
      {%- if s.bio %}<p class="ql-led-bio">{{ s.bio }}</p>{% endif %}
      {%- if s.quote %}<blockquote class="ql-led-q">“{{ s.quote }}”</blockquote>{% endif %}
    </div>
    <dl class="ql-spec">
      {%- if s.days %}<div><dt>Days</dt><dd>{{ s.days }}</dd></div>{% endif %}
      {%- if s.years %}<div><dt>{{ "Years" if site.team.yearsLabel else "Years in the chair" }}</dt><dd>{{ s.years }}</dd></div>{% endif %}
      {%- if s.knownFor %}<div><dt>Known for</dt><dd>{{ s.knownFor | join(", ") }}</dd></div>{% endif %}
      {%- set best = site.team.filters | withTags(s.tags) %}
      {%- if best.length %}<div><dt>{{ site.team.filtersLabel or "Best for" }}</dt><dd>{% for f in best %}{{ f.label }}{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>{% endif %}
    </dl>
    {%- if not site.team.showcase %}
    {%- set msg = "Hi, can I book in with " + s.name + "? What's the next free slot?" %}
    <a class="ql-led-book" href="{{ msg | book }}"{% if build.booking.whatsapp %} data-wa-text="{{ msg }}"{% endif %} target="_blank" rel="noopener">Book with {{ s.name }}</a>
    {%- endif %}
  </article></li>
  {%- endfor %}
  </ol>
  {%- if site.team.showcase %}
  <p class="ql-led-foot rv"><span>{{ site.team.bookLine or "Book the work, and the right person for it does it." }}</span> <a class="ql-led-book" href="{{ site.messages.general | book }}"{% if build.booking.whatsapp %} data-wa-text="{{ site.messages.general }}"{% endif %} target="_blank" rel="noopener">{{ build.booking.label }}</a></p>
  {%- endif %}
</div>
{%- if site.team.hiring %}
<section class="ql-hire"><div class="wrap ql-hire-in rv">
  <p class="ql-hire-k">{{ site.team.hiring.kicker }}</p><h2>{{ site.team.hiring.title }}</h2><p>{{ site.team.hiring.text }}</p>
  <a class="ql-v-go" href="{{ site.team.hiring.message | wa }}" data-wa-text="{{ site.team.hiring.message }}" target="_blank" rel="noopener">Ask about the job</a>
</div></section>
{%- endif %}
