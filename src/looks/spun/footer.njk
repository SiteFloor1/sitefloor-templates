{#- Spun footer: the usual week as a row of small tickets, the pages and the ways to reach the stall, then the credit. -#}
<footer class="foot sp-foot"><div class="wrap">
  <p class="sp-foot-name">{{ site.business.name }}</p>
  {%- if site.stops %}
  <ul class="sp-foot-week" aria-label="Usually">
    {%- for u in site.stops.usual %}{% set p = site.stops | stallPlace(u.place) %}<li><b>{{ u.day | capitalize }}</b> {{ p.name }} {{ u.open }}–{{ u.close }}</li>{% endfor %}
  </ul>
  {%- endif %}
  <div class="sp-foot-in">
    <nav class="sp-foot-links" aria-label="Footer">
      <a href="{{ 'index' | href }}">Home</a>
      {%- for item in site.nav | navItems(pageId) %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}>{{ item.label }}</a>{% endfor %}
      <a href="{{ 'privacy' | href }}">Privacy</a>
    </nav>
    <p class="sp-foot-c"><a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a>{% if site.contact.email %}<br><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}{% if site.posts and site.posts.tiktokProfile %}<br><a href="{{ site.posts.tiktokProfile }}" rel="noopener">TikTok</a>{% if site.posts.instagramProfile %} · <a href="{{ site.posts.instagramProfile }}" rel="noopener">Instagram</a>{% endif %}{% endif %}</p>
  </div>
  <p class="sp-foot-by"><a class="by" href="https://sitefloor.com" rel="noopener">Website by <b>Sitefloor</b></a></p>
</div></footer>
