{#- Verrière section opening: the section's name in Hina Mincho, its line beneath in the same face, set left. No small
    label above. `sec` = { kicker, title, intro }; the kicker is not shown. -#}
<div class="vr-sh rv">
  <h2 class="vr-sh-t">{{ sec.title | markup | safe }}</h2>
  {%- if sec.intro %}<p class="vr-sh-i">{{ sec.intro }}</p>{% endif %}
</div>
