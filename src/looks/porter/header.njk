{#- Porter header: the agent's name set large on the left; Residences, Owners and Fees (always: fees must be shown
    prominently) and the telephone on the right. On phones, "Menu" opens the same pages, Fees among them. -#}
<header class="nav pt-nav">
<div class="wrap pt-nav-in">
  <a class="pt-mark" href="{{ 'index' | href }}" aria-label="{{ site.business.name }}, home">
    {%- if site.brand and site.brand.logo %}<img src="{{ site.brand.logo | img }}" alt="{{ site.business.name }}" height="34">{% else %}{{ site.business.name }}{% endif %}</a>
  <nav class="pt-links" aria-label="Main">
    {%- for item in site.nav | navItems(pageId) %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
    <a class="pt-tel" href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone | replace('+44 ', '0') }}</a>
  </nav>
  <button class="burger pt-menu" type="button" aria-expanded="false" aria-controls="mnav"><span class="pt-open">Menu</span><span class="pt-close">Close</span></button>
</div>
</header>
<div class="mnav pt-sheet" id="mnav" hidden>
  <nav aria-label="Pages">
    <a href="{{ 'index' | href }}"{% if pageId == "index" %} aria-current="page"{% endif %}>{{ site.business.name }}</a>
    {%- for item in site.nav | navItems(pageId) %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
  </nav>
  <p class="pt-sheet-now" data-live-status><span class="dot" aria-hidden="true"></span> <span data-status-text>Office hours</span></p>
  <p class="pt-sheet-addr">{{ site.location.streetAddress }}, {{ site.location.locality }} {{ site.location.postcode }}</p>
</div>
