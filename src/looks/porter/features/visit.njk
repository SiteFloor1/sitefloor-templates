{#- Porter office: the address and the week's hours as a ruled table, today marked, the live status above. On the
    fees page, after the schemes: who the agent is and where to find it. -#}
<section id="visit" class="pt-visit" data-feature="visit" aria-labelledby="pt-visit-h">
  <h2 id="pt-visit-h">{{ site.sections.visit.title }}</h2>
  <div class="pt-visit-in">
    <address>{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}{% if site.location.area %}<br><span>{{ site.location.area }}</span>{% endif %}<br><a href="{{ site.location.directionsUrl }}" rel="noopener">Directions</a></address>
    <div data-hours>
      <p class="pt-visit-now" data-live-status><span class="dot" aria-hidden="true"></span> <span data-status-text>Office hours</span></p>
      <p class="pt-visit-fine" data-status-detail></p>
      <table class="pt-hrs"><caption class="sr-only">Office hours</caption><tbody>{% for row in site.hours | hoursRows %}<tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>{% endfor %}</tbody></table>
      {%- set upcoming = site.hours | upcomingExceptions(build.today) %}
      {%- if upcoming.length %}<ul class="pt-visit-ex">{% for ex in upcoming %}<li><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </div>
</section>
