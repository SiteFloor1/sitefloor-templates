{#- Mackerel header: the studio's name left in the display face, the pages right in small muted words, Book lit. On
    the home page it sits over the headlight photograph; on phones "Menu" opens the pages. -#}
<header class="nav mk-nav"><div class="wrap mk-nav-in">
  <a class="mk-brand" href="{{ 'index' | href }}" aria-label="{{ site.business.name }}, home">
    {%- if site.brand and site.brand.logo %}<img src="{{ site.brand.logo | img }}" alt="{{ site.business.name }}" height="32">{% else %}{{ site.business.name }}{% endif %}
  </a>
  <nav class="mk-links" aria-label="Main">
    {%- for item in site.nav | navItems(pageId) %}
    <a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>
  <a class="mk-book" href="{{ site.messages.general | book }}"{% if build.booking.whatsapp %} data-wa-text="{{ site.messages.general }}"{% endif %} target="_blank" rel="noopener">Book</a>
  <button class="burger mk-menu" type="button" aria-expanded="false" aria-controls="mnav"><span class="mk-open">Menu</span><span class="mk-close">Close</span></button>
</div></header>
<div class="mnav mk-sheet" id="mnav" hidden>
  <nav aria-label="Pages">
    <a href="{{ 'index' | href }}"{% if pageId == "index" %} aria-current="page"{% endif %}>The bay</a>
    {%- for item in site.nav | navItems(pageId) %}
    <a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>
  <span class="tube" aria-hidden="true"></span>
  <p class="mk-sheet-now" data-live-status><span class="dot" aria-hidden="true"></span> <span data-status-text>Opening hours</span></p>
  <p class="mk-sheet-addr">{{ site.location.streetAddress }}, {{ site.location.locality }} {{ site.location.postcode }}</p>
</div>
