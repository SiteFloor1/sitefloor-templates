{#- Verge footer: a white card on the grey ground. The name and what the instructor teaches, how to reach them, lesson
    hours, every page, gov.uk's three links; the Sitefloor credit last. -#}
<footer class="foot vg-foot"><div class="wrap"><div class="vg-foot-in">
  <div>
    <p class="vg-foot-name">{{ site.business.name }}</p>
    <p>{{ site.business.description }}</p>
    <address>{{ site.location.streetAddress }}, {{ site.location.locality }} {{ site.location.postcode }}<br>
      <a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a>{% if site.contact.email %} · <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>{% endif %}</address>
  </div>
  <ul class="vg-foot-hours" aria-label="Lesson hours">
    {%- for row in site.hours | hoursRows %}<li data-day="{{ row.dayIndex }}"><span>{{ row.day }}</span> {{ row.label }}</li>{% endfor %}
  </ul>
  <nav class="vg-foot-links" aria-label="Footer">
    <a href="{{ 'index' | href }}">Home</a>
    {%- for item in site.nav | navItems(pageId) %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}>{{ item.label }}</a>{% endfor %}
    <a href="{{ 'privacy' | href }}">Privacy</a>
  </nav>
  <ul class="vg-foot-gov" aria-label="On gov.uk">
    {%- for k in ["provisional", "theory", "practical"] %}<li><a href="{{ govuk.links[k].url }}">{{ govuk.links[k].label }}</a></li>{% endfor %}
  </ul>
</div>
<p class="vg-foot-by"><a class="by" href="https://sitefloor.com" rel="noopener">Website by <b>Sitefloor</b></a></p>
</div></footer>
