{#- Foreshore hours: the week as a plain ruled table with today marked and the live status above it. Shown on the
    Before we meet page; the home page's office band carries the address and hours itself. -#}
<section id="visit" class="fs-pv fs-visit" data-feature="visit"><div class="wrap">
  <h2 class="fs-pv-h">{{ "Opening hours" if visitHeading == false else site.sections.visit.title }}</h2>
  <div data-hours>
    <p class="fs-pv-now" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Opening hours</span></p>
    <p class="fs-pv-fine" data-status-detail></p>
    <table class="fs-hrs"><caption class="sr-only">Opening hours</caption><tbody>{% for row in site.hours | hoursRows %}<tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>{% endfor %}</tbody></table>
    {%- set upcoming = site.hours | upcomingExceptions(build.today) %}
    {%- if upcoming.length %}<ul class="fs-pv-ex">{% for ex in upcoming %}<li><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</li>{% endfor %}</ul>{% endif %}
  </div>
</div></section>
