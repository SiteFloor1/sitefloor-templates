{#- Foreshore "Before we meet": the address and the office's hours now, how to get there (each way as a short route),
    parking and access as plain notes, the week's hours, then the questions families ask before a first meeting.
    Same logic as the shared page; every script hook kept. -#}
{%- set v = site.visitInfo %}
{%- set journeys = v.journeys or [] %}
{%- set parking = v.parking or [] %}
{%- set ph = { title: v.title | plain, intro: v.intro } %}
{% include "kits/wealth/partials/page-head.njk" %}
<div data-feature="plan-visit">
<section class="fs-pv"><div class="wrap fs-pv-top">
  <div>
    <p class="fs-pv-addr">{{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}</p>
    <p class="fs-pv-now" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Hours below</span></p>
  </div>
  <dl class="fs-pv-dl">
    {%- for j in journeys %}<div><dt>{{ j.from }}</dt><dd>{{ j | boardTime }}</dd></div>{% endfor %}
    {%- for c in parking %}<div><dt>{{ c.name }}</dt><dd data-parking="{{ loop.index0 }}">{% if c.walk is defined %}{{ c.walk }} min walk{% endif %}</dd></div>{% endfor %}
  </dl>
  {%- if site.mode == "demo" %}<p class="fs-pv-fine">Example journeys for a fictional firm.</p>
  {%- elif v.checked %}<p class="fs-pv-fine">Checked with {{ site.business.name }} in {{ v.checked | checkedText }}.</p>{% endif %}
</div></section>
{%- if journeys.length %}
<section class="fs-pv" aria-labelledby="pv-j-h"><div class="wrap">
  <h2 class="fs-pv-h" id="pv-j-h">Getting here</h2>
  <div class="fs-pv-tabs" role="tablist" aria-label="Ways to get here" data-pv-tabs hidden>
    {%- for j in journeys %}<button type="button" role="tab" id="pv-tab-{{ loop.index0 }}" aria-controls="pv-panel-{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}">{{ (j.mode | modeWords).tab }}</button>{% endfor %}
  </div>
  {%- for j in journeys %}
  <div class="fs-pv-way" id="pv-panel-{{ loop.index0 }}" data-pv-panel>
    <p class="fs-pv-from"><b>{{ j.from }}</b>{% if j.stop %}, get off at {{ j.stop }}{% endif %} <span>{% if (j.mode | modeWords).about %}about {% endif %}{{ j.minutes }} min {{ (j.mode | modeWords).verb }}</span></p>
    <ol class="wm-le-l">{% for step in j.steps %}<li>{{ step }}</li>{% endfor %}<li><b>{{ site.business.name }}</b>, {{ site.location.streetAddress }}</li></ol>
    <a class="wm-go" href="{{ j | directionsFor }}" target="_blank" rel="noopener">Directions in Google Maps</a>
  </div>
  {%- endfor %}
  <div class="fs-pv-leave" data-pv-leave hidden>
    <label for="pv-appt">Meeting us at a set time? We'll say when to leave.</label>
    <input type="time" id="pv-appt" step="900" data-pv-appt>
    <ul data-pv-leave-list aria-live="polite"></ul>
  </div>
</div></section>
{%- endif %}
{%- if parking.length or v.access or v.payment %}
<section class="fs-pv"><div class="wrap fs-pv-notes">
  {%- if parking.length %}<div><h2 class="fs-pv-h">Parking</h2>
    {%- for c in parking %}<div class="fs-pv-note"><h3>{{ c.name }}</h3><p data-parking-card="{{ loop.index0 }}" hidden></p><p>{{ c | parkingSummary }}</p><p class="fs-pv-fine">{% if c.walk is defined %}{{ c.walk }} min walk{% endif %}{% if c.walk is defined and c.price %} · {% endif %}{{ c.price }}</p>{% if c.note %}<p>{{ c.note }}</p>{% endif %}</div>{% endfor %}
  </div>{% endif %}
  <div>
    {%- if v.access %}<h2 class="fs-pv-h">Access</h2>
    <ul class="wm-le-l">{% for a in v.access %}<li>{{ "Yes: " if a.yes else "No: " }}{{ a.label }}</li>{% endfor %}</ul>
    {%- if v.accessNote %}<p>{{ v.accessNote }}</p>{% endif %}{% endif %}
    {%- if v.payment %}<h2 class="fs-pv-h">Paying us</h2><p>{{ v.payment }}</p>{% endif %}
  </div>
</div></section>
{%- endif %}
</div>
{%- set visitHeading = false %}
{% include "features/visit/visit.njk" %}
{%- set groups = site | questionTopics %}
{%- if groups.length %}
<section class="fs-pv" id="questions"><div class="wrap">
  <h2 class="fs-pv-h">Questions families ask</h2>
  <div class="fs-pv-q">{% for g in groups %}<div><h3>{{ g.topic }}</h3>{% for item in g.items %}<details class="fs-qa"><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>{% endfor %}</div>{% endfor %}</div>
</div></section>
{%- endif %}
