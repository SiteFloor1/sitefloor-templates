{#- Statement header: a holly-green band. The seal and the firm's name in spaced capitals on the left; the pages, the
    phone number and a framed "First meeting" on the right. On a phone: the seal, the name and Menu; the phone bar
    keeps the call and the first meeting in reach. -#}
{%- include "kits/ifa/partials/meet-href.njk" %}
{%- set items = site.nav | navItems(pageId) %}
<header class="nav st-band"><div class="st-band-in">
  <a class="st-brand" href="{{ 'index' | href }}" aria-label="{{ site.business.name }}, home">
    {%- if site.brand and site.brand.logo %}<img src="{{ site.brand.logo | img }}" alt="{{ site.business.name }}" height="40">{% else %}{% include "looks/statement/features/ifa-statement/mark.njk" %}<span class="st-word">{{ site.business.name }}</span>{% endif %}
  </a>
  <nav class="st-nav" aria-label="Main">
    {%- for item in items %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
    <a class="st-tel" href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a>
    <a class="st-book" href="{{ meetHref }}">First meeting</a>
  </nav>
  <button class="burger st-menu" type="button" aria-expanded="false" aria-controls="mnav"><span class="st-open">Menu</span><span class="st-close">Close</span></button>
</div></header>
<div class="mnav st-sheet" id="mnav" hidden>
  <nav aria-label="Pages">
    <a href="{{ 'index' | href }}"{% if pageId == "index" %} aria-current="page"{% endif %}>Home</a>
    {%- for item in items %}<a href="{{ item.url }}"{{ item.feature | tierAttr | safe }}{% if item.page and item.page == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
  </nav>
  <p class="st-sheet-now" data-live-status><span class="dot" aria-hidden="true"></span> <span data-status-text>Office hours</span></p>
  <p class="st-sheet-addr">{{ site.location.streetAddress }}, {{ site.location.locality }} {{ site.location.postcode }}</p>
</div>
