{#- End of tenancy: what to do before the cleaners arrive, the room-by-room checklist to tick as you go (kept on this
    device only while the page is open), the company's own re-clean terms word for word, and the deposit rules linked to
    gov.uk with the month checked. A deposit is never promised. The move-out planner (Signature) sits above the list. -#}
{%- set t = site.tenancy %}
<section class="cl-ten" data-feature="cleaning-tenancy"><div class="wrap cl-ten-in">
  <aside class="cl-ten-side">
    {%- if "cleaning-moveout" | enabled %}{% include "kits/cleaning/features/cleaning-moveout/cleaning-moveout.njk" %}{% endif %}
    <h2>Before we arrive</h2>
    <ul class="cl-ten-before">{% for b in t.before %}<li>{{ b }}</li>{% endfor %}</ul>
    <h2>If something is missed</h2>
    <p class="cl-ten-terms">{{ t.terms }}</p>
    <p class="cl-fine">Your deposit is a matter between you and your landlord. The rules on protecting and returning it: <a href="{{ t.depositLink }}" rel="noopener">GOV.UK, tenancy deposit protection</a> (checked {{ t.checked | monthYear }}).</p>
  </aside>
  <div class="cl-ten-list" data-ten-list>
    <p class="cl-ten-count" data-ten-count data-js-only aria-live="polite"></p>
    {%- for r in t.rooms %}
    <fieldset class="cl-ten-room"><legend>{{ r.name }}</legend>
      {%- set ri = loop.index0 %}
      {%- for i in r.items %}<label><input type="checkbox" data-js-only name="r{{ ri }}-{{ loop.index0 }}"><span>{{ i }}</span></label>{% endfor %}
    </fieldset>
    {%- endfor %}
  </div>
</div></section>
