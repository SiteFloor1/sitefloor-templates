{#- A service's own page: one photograph, the worked example (its own room strip and bill, from visit()), the task list
    room by room with what this service adds, what isn't included, then the company's own words. -#}
{%- set V = site.visit %}{%- set pg = s.page %}
{%- if pg.photo %}<figure class="cl-svc-photo"><div class="wrap"><img src="{{ pg.photo.src | img }}" alt="{{ pg.photo.alt }}" width="{{ pg.photo.width }}" height="{{ pg.photo.height }}" fetchpriority="high" decoding="async">{% if pg.photo.credit %}<figcaption>Photograph: {{ pg.photo.credit }}</figcaption>{% endif %}</div></figure>{% endif %}
{%- if s.example %}{% include "kits/cleaning/partials/worked.njk" %}{% endif %}
<section class="cl-svc" data-feature="cleaning-service-pages" aria-labelledby="svc-tasks"><div class="wrap">
  {%- if s.example %}
  <h2 id="svc-tasks" class="cl-svc-h">Room by room</h2>
  <div class="cl-svc-rooms">
    {%- for k in ["kitchen", "hall", "bed", "bath"] %}{%- set r = V.rooms[k] %}
    <div><h3>{{ r.name }}</h3>
      <ul>{% for t in r.tasks %}<li>{{ t }}</li>{% endfor %}{% for t in (pg.adds[k] if pg.adds else []) %}<li class="cl-svc-add">{{ t }}</li>{% endfor %}</ul>
    </div>
    {%- endfor %}
  </div>
  {%- if pg.adds %}<p class="cl-fine"><span class="cl-svc-key" aria-hidden="true"></span> Marked: what {{ s.name | lower }} adds to a regular visit.</p>{% endif %}
  {%- endif %}
  <div class="cl-svc-in">
    <div>
      {%- if pg.also %}<h2 class="cl-svc-h">Every {{ s.name | lower }} visit</h2><ul class="cl-svc-list">{% for t in pg.also %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
      {%- if pg.not %}<h2 class="cl-svc-h">Not included</h2><ul class="cl-svc-list cl-svc-not">{% for t in pg.not %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
    </div>
    <div>
      {%- set secs = pg.sections %}{% include "kits/cleaning/partials/sections.njk" %}
      <p class="cl-svc-go"><a class="cl-send" href="{{ ('Hello ' + site.business.name + ', I\'d like to ask about ' + (s.name | lower) + '.') | book }}" target="_blank" rel="noopener">Ask about {{ s.name | lower }}</a>{% if "cleaning-strip" | enabled %} <a href="{{ 'index' | href }}">Work out your own home</a>{% endif %}</p>
    </div>
  </div>
</div></section>
