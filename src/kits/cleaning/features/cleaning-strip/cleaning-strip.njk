{#- The visit, room by room: the line saying what the strip shows, the controls (bedrooms, bathrooms, how often), a
    ruler in minutes and the strip itself, each room as wide as its minutes with a hairline per minute; tap a room for
    its tasks. Rendered for the company's default home before any script runs, from the same visit() the browser uses,
    so every figure is right without JavaScript too. The look places it (Plumb: under the hero photograph). -#}
{%- set V = site.visit %}{%- set d = V.defaults %}
{%- set v = V | visitOf(d) %}{%- set w = v | visitWords(d, site.business.name) %}
{%- set parts = v.rooms.concat(v.extras) %}
<div class="cl-strip" data-feature="cleaning-strip"{{ 'cleaning-strip' | tierAttr | safe }}>
  <div class="cl-st-top">
    <p class="cl-st-say" data-st-say aria-live="polite">A {{ w.home }}: <b data-st-fig>{{ w.figures }}</b>. <span data-st-hint>{{ V.line or "Change it to yours." }}</span></p>
    <form class="cl-st-ctl" data-st-ctl data-js-only>
      <fieldset><legend>Bedrooms</legend><div class="cl-seg">{% for n in [1, 2, 3, 4] %}<label><input type="radio" name="beds" value="{{ n }}"{% if n == d.beds %} checked{% endif %}><span>{{ n }}</span></label>{% endfor %}</div></fieldset>
      <fieldset><legend>Bathrooms</legend><div class="cl-seg">{% for n in [1, 2, 3] %}<label><input type="radio" name="baths" value="{{ n }}"{% if n == d.baths %} checked{% endif %}><span>{{ n }}</span></label>{% endfor %}</div></fieldset>
      <fieldset class="cl-st-often"><legend>How often</legend><div class="cl-seg">{% for f in [["week", "Weekly"], ["fortnight", "Fortnightly"], ["once", "Once, deep"]] %}<label><input type="radio" name="freq" value="{{ f[0] }}"{% if f[0] == d.freq %} checked{% endif %}><span>{{ f[1] }}</span></label>{% endfor %}</div></fieldset>
    </form>
  </div>
  <div class="cl-ruler" data-st-ruler aria-hidden="true">
    {%- for t in v.work | ruler %}<i class="{{ 'cl-r30' if t.label }}" style="left:{{ t.at }}%"></i>{% if t.label %}<b style="left:{{ t.at }}%">{{ t.label }}</b>{% endif %}{% endfor %}<b class="cl-r-end">{{ v.work | hm }}</b>
  </div>
  <div class="cl-rooms" data-st-rooms role="group" aria-label="Rooms, each as long as its minutes">
    {%- for r in parts %}
    <button type="button" class="cl-room{{ ' cl-extra' if r.extra }}" data-id="{{ r.id }}" style="--m:{{ r.min }}" aria-pressed="false"><i class="cl-mins" aria-hidden="true"></i><span class="cl-n">{{ r.min }}<small> min</small></span><span class="cl-nm"><span class="cl-k">{{ r.tasks.length }} tasks</span>{{ r.name }}</span></button>
    {%- endfor %}
  </div>
  <div class="cl-detail" data-st-detail aria-live="polite">
    {%- set r = v.rooms[0] %}
    <h2>{{ r.name }}<span>{{ r.min | hm }}<span class="cl-tap" data-js-only> · tap any room</span></span></h2>
    <ul>{% for t in r.tasks %}<li>{{ t }}</li>{% endfor %}</ul>
    <p>{{ r.not }}</p>
  </div>
  {%- if "cleaning-3d" | enabled %}{% include "kits/cleaning/features/cleaning-3d/cleaning-3d.njk" %}{% endif %}
</div>
