{#- Arrive at night on the home page: the first three steps; with the aerial hall, the night view beside them. -#}
<section id="night" class="gn gn-home" aria-labelledby="gn-h"{{ "garage-night" | tierAttr | safe }}><div class="wrap gn-in">
  <div class="gn-side">
    <h2 id="gn-h" class="gn-h">Arriving at night</h2>
    <ol class="gn-short" data-night-steps>
      {%- for s in site.night.steps %}{% if loop.index <= 3 %}<li>{{ s.title }}</li>{% endif %}{% endfor %}
    </ol>
    <a class="go" href="{{ 'arrive-at-night' | href }}">Gate to bay, step by step</a>
  </div>
  {%- if "garage-aerial" | enabled %}{% include "kits/garage/features/garage-night/garage-night-aerial.njk" %}{% endif %}
</div></section>
