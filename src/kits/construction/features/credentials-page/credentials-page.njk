{#- Accreditations and insurance in full: each membership with its number and register, each cover with its limit
    and insurer, the guarantee, and when it was last checked against the certificates. -#}
{%- set c = site.credentials %}
{%- set ph = { title: c.title or "Accreditations and *insurance*", intro: c.intro } %}
{% include "kits/construction/partials/page-head.njk" %}
<div class="wrap bd-cp">
  {%- if c.items.length %}<section aria-labelledby="cp-m"><h2 id="cp-m" class="bd-h3">Memberships</h2>
    <dl class="bd-cp-list">{% for x in c.items %}<div><dt>{{ x.name }}</dt><dd>{% if x.number %}Number {{ x.number }}{% if site.mode == "demo" %} (demo){% endif %}{% endif %}{% if x.checkUrl %}<br><a href="{{ x.checkUrl }}" rel="noopener" target="_blank">Check it on the register</a>{% endif %}</dd></div>{% endfor %}</dl></section>{% endif %}
  {%- if c.insurance and c.insurance.length %}<section aria-labelledby="cp-i"><h2 id="cp-i" class="bd-h3">Insurance</h2>
    <dl class="bd-cp-list">{% for x in c.insurance %}<div><dt>{{ x.cover }}</dt><dd>{{ x.amount }}{% if x.insurer %}<br>{{ x.insurer }}{% endif %}</dd></div>{% endfor %}</dl>
    </section>{% endif %}
  {%- if c.warranties and c.warranties.length %}<section aria-labelledby="cp-w"><h2 id="cp-w" class="bd-h3">Warranties</h2>
    <dl class="bd-cp-list">{% for w in c.warranties %}<div><dt>{{ w.name }}</dt><dd>{{ w.covers }}{% if w.length %}<br>{{ w.length }}{% endif %}</dd></div>{% endfor %}</dl></section>{% endif %}
  {%- if c.guarantee %}<section aria-labelledby="cp-g"><h2 id="cp-g" class="bd-h3">Guarantee</h2><p>{{ c.guarantee }}</p></section>{% endif %}
  <p class="bd-cp-when">Checked against our certificates in {{ c.updated | monthWords }}.{% if site.mode == "demo" %} Demo details: a real site shows the builder's own.{% endif %}</p>
</div>
