{#- Accreditations and insurance, from the builder's own certificates only: each membership with its number and the
    public register to check it, each insurance cover with its limit, the guarantee, and when it was last checked.
    Never a logo, never a scheme the builder hasn't shown us. -#}
{%- set c = site.credentials %}
<section class="bd-cred" id="accreditations" aria-labelledby="cred-h"><div class="wrap bd-cred-in">
  <h2 id="cred-h" class="bd-h3">{{ (c.title or "Accreditations and *insurance*") | markup | safe }}</h2>
  <dl class="bd-cred-list">
    {%- for x in c.items %}<div><dt>{{ x.name }}</dt><dd>{% if x.number %}Number {{ x.number }}{% if site.mode == "demo" %} (demo){% endif %}{% endif %}{% if x.checkUrl %} · <a href="{{ x.checkUrl }}" rel="noopener" target="_blank">Check the register</a>{% endif %}</dd></div>{% endfor %}
    {%- for x in c.insurance %}<div><dt>{{ x.cover }}</dt><dd>{{ x.amount }}{% if x.insurer %}, {{ x.insurer }}{% endif %}</dd></div>{% endfor %}
    {%- if c.guarantee %}<div><dt>Guarantee</dt><dd>{{ c.guarantee }}</dd></div>{% endif %}
  </dl>
  <p class="bd-cred-when">Checked against our certificates in {{ c.updated | monthWords }}.{% if site.mode == "demo" %} Demo details: a real site shows the builder's own.{% endif %}{% if "credentials-page" | enabled %} <a href="{{ 'accreditations' | href }}"{{ 'credentials-page' | tierAttr | safe }}>In full</a>{% endif %}</p>
</div></section>
