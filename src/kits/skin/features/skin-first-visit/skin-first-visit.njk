{#- First visit and patch tests (BEAU-2): the clinic's paragraphs on a first visit, its own patch-test rule, and the
    day to come in for one worked out from the appointment (on or before), to the calendar or to the clinic. Without
    JavaScript the rule shows on its own. Used on the home page and the first visit page (`firstVisitPage`); with that page on, the home page keeps
    only the patch-test card, so it stays short on a phone. -#}
{%- set fv = site.firstVisit %}
{%- set sec = site.sections.firstVisit %}
<section id="first-visit" class="sk-fv" data-feature="skin-first-visit" aria-label="{{ (fv.title if firstVisitPage else sec.title) | plain }}"{{ 'skin-first-visit' | tierAttr | safe }}><div class="wrap sk-fv-in">
  {%- if not firstVisitPage and not ("skin-first-visit-page" | enabled) %}{% include "core/partials/section-head.njk" %}{% endif %}
  <div class="sk-fv-grid{% if firstVisitPage or ("skin-first-visit-page" | enabled) %} sk-fv-one{% endif %}">
    {%- if not firstVisitPage and not ("skin-first-visit-page" | enabled) %}
    <dl class="sk-fv-dl">{% for s in fv.sections | batch(3) | first %}<div><dt>{{ s.heading }}</dt><dd>{{ s.text }}</dd></div>{% endfor %}</dl>
    {%- endif %}
    <div class="sk-patch">
      <h3 class="sk-patch-t">Patch tests</h3>
      <p class="sk-patch-l">{{ fv.patch.line }}</p>
      <div class="sk-patch-tool" data-js-only>
        <label class="sk-patch-f"><span>Your appointment</span> <input type="date" data-pt-date></label>
        <p class="sk-patch-out" data-pt-out aria-live="polite"></p>
        <div class="sk-patch-acts">
          <button type="button" class="sk-quiet" data-pt-ics hidden>Add the patch test to my calendar</button>
          <a class="sk-quiet" data-pt-send href="{{ fv.title | book }}" target="_blank" rel="noopener" hidden>Book the patch test with {{ site.business.name }}</a>
        </div>
      </div>
      {%- if not firstVisitPage and ("skin-first-visit-page" | enabled) %}<p class="sk-more-l"><a class="go" href="{{ 'first-visit' | href }}"{{ 'skin-first-visit-page' | tierAttr | safe }}>Your first visit, in full</a></p>{% endif %}
    </div>
  </div>
</div></section>
