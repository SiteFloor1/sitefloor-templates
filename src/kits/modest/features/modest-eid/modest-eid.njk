{#- Eid last order dates (MOD-5): the next Eid's expected window from the shared lunar table, and the shop's own
    cut-offs counted back from its first day, each with the days left; one that has passed says closed. The dates
    are drawn at build time for the build day, so the section has its shape on first paint, and the browser redraws
    them in place for the real day; with no Eid ahead in the table the section hides itself. -#}
{%- set sec = site.sections.eid %}
{%- set r = site.eid | eidNow %}
<section id="eid" class="md-eid"{% if not r %} hidden{% endif %} data-feature="modest-eid" aria-label="{{ sec.title | plain }}"{{ "modest-eid" | tierAttr | safe }}><div class="wrap md-eid-in">
  {%- include "core/partials/section-head.njk" %}
  <div class="md-eid-body">
    <p class="md-eid-w" data-eid-when>{{ r.words if r }}</p>
    <table class="md-eid-t"><caption class="md-eid-c">Last order dates</caption><tbody data-eid-rows>
      {%- for c in site.eid.cutoffs %}{% set x = r.rows[loop.index0] if r else null %}<tr{% if x and not x.open %} class="is-closed"{% endif %}><td>{{ c.label }}</td><td>{% if x %}Order by {{ x.byWords }}{% else %}{{ c.daysBefore | daysWords }} before Eid{% endif %}</td><td>{{ (x | leftWords) if x }}</td></tr>{% endfor %}
    </tbody></table>
    {%- if site.eid.note %}<p class="md-eid-n">{{ site.eid.note }}</p>{% endif %}
    {%- if ("modest-family" | enabled) and pageId != "eid" %}<p><a class="md-ask" href="{{ 'eid' | href }}"{{ "modest-family" | tierAttr | safe }}>Order for the whole family</a></p>{% endif %}
  </div>
</div></section>
