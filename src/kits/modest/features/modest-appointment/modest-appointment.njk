{#- Private appointments (MOD-10): the studio's standing times on the coming dates, how many are coming and what for,
    sent as a request on WhatsApp; the shop confirms by message. Without JavaScript: the weekly times and WhatsApp. -#}
{%- set A = site.appointments %}
{%- set ph = { title: "A private appointment", intro: A.intro } %}
{% include "kits/modest/partials/page-head.njk" %}
<section class="md-ap" data-feature="modest-appointment" aria-label="Request an appointment"><div class="wrap">
  <form class="md-ap-f" data-js-only data-ap-form>
    <fieldset class="md-ap-days"><legend>Day</legend><div class="md-ap-opts" data-ap-days></div></fieldset>
    <fieldset class="md-ap-times"><legend>Time</legend><div class="md-ap-opts" data-ap-times></div></fieldset>
    <div class="md-ap-two">
      <p><label for="ap-n">How many of you</label><select id="ap-n" name="n">{% for i in range(1, (A.most or 4) + 1) %}<option value="{{ i }}">{{ i }}</option>{% endfor %}</select></p>
      <p><label for="ap-for">What it's for</label><select id="ap-for" name="for">{% for r in A.reasons %}<option>{{ r }}</option>{% endfor %}</select></p>
    </div>
    <p class="md-ap-sum" data-ap-sum aria-live="polite"></p>
    <a class="btn" data-ap-send href="{{ site.messages.general | book }}" target="_blank" rel="noopener">Request this time</a>
    <p class="md-ap-note">{{ A.minutes }} minutes in the studio. This is a request: we confirm by message.</p>
  </form>
  <div data-no-js>
    <ul class="md-ap-week">{% for d, t in A.weekly %}{% if t.length %}<li>{{ d | capitalize }}: {{ t | join(", ") }}</li>{% endif %}{% endfor %}</ul>
    <a class="btn" href="{{ site.messages.general | book }}" target="_blank" rel="noopener">Ask for a time</a>
  </div>
</div></section>
