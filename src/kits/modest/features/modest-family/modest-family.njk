{#- The Eid family list (MOD-11): the Eid dates, then one list the family fills in (each person's name, piece and
    length) with the total. The list lives only in the page's address, so "Send the list to the family" shares a link
    and nothing is stored; "Send our order" sends it all to the shop. Then the Eid edit. -#}
{%- set F = site.family %}
{%- set ph = { title: "Eid, for the whole family", intro: F.intro } %}
{% include "kits/modest/partials/page-head.njk" %}
{%- set ef = F.photo or (site.pieces | piece(F.pieces[0])).photo %}
{% include "kits/modest/features/modest-eid/modest-eid.njk" %}
<section class="md-fam" data-feature="modest-family" aria-label="The family's list"><div class="wrap md-fam-in">
  <div class="md-fam-list">
    <h2 class="md-fam-h">The family's list</h2>
    <ol class="md-fam-rows" data-fam-rows data-js-only></ol>
    <template data-fam-row>
      <li class="md-fam-row">
        <input name="name" type="text" maxlength="24" autocomplete="off" placeholder="Name" aria-label="Name">
        <select name="piece" aria-label="Piece">{% for id in F.pieces %}{% set fp = site.pieces | piece(id) %}<option value="{{ fp.id }}">{{ fp.name }} · {{ fp.price | gbp }}</option>{% endfor %}</select>
        <select name="length" aria-label="Length"></select>
        <button type="button" class="md-fam-x" data-fam-remove aria-label="Remove">Remove</button>
      </li>
    </template>
    <p class="md-fam-add" data-js-only><button type="button" class="md-v" data-fam-add>Add someone</button></p>
    <p class="md-fam-tot" data-js-only>Together <b data-fam-total>£0</b></p>
    <div class="md-fam-go" data-js-only>
      <a class="btn" data-fam-send href="{{ site.messages.general | book }}" target="_blank" rel="noopener">Send our order</a>
      <button type="button" class="btn ghost" data-fam-share>Send the list to the family</button>
    </div>
    <p class="md-fam-note" data-js-only data-fam-note aria-live="polite">The list is kept only in this page's link: nothing is saved on our side.</p>
    <p data-no-js><a class="btn" href="{{ site.messages.general | book }}" target="_blank" rel="noopener">Send us the family's order</a></p>
  </div>
  {%- if ef %}<figure class="md-fam-ph"><img src="{{ ef.src | img }}" width="{{ ef.width }}" height="{{ ef.height }}" alt="{{ ef.alt }}" loading="lazy" decoding="async"></figure>{% endif %}
</div></section>
<section class="md-edit" aria-label="The Eid edit"><div class="wrap">
  <h2 class="md-fam-h">The Eid edit</h2>
  <ul class="md-pieces">{% for p in site.pieces | eidEdit %}{% include "kits/modest/partials/piece.njk" %}{% endfor %}</ul>
</div></section>
