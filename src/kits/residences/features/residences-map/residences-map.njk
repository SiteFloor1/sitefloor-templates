{#- Neighbourhood guide (Signature): the operator's places, drawn around the building on rings of walking time.
    Minutes are the operator's, or an estimate marked "about". Drawn at build time; no map service, no ratings. -#}
{%- set n = site.neighbourhood %}
{%- set pts = n | mapLayout(560) %}
<div class="rm" data-feature="residences-map">
  <figure class="rm-fig">
    <svg viewBox="0 0 560 560" role="img" aria-labelledby="rm-t"><title id="rm-t">Places near {{ site.business.name }}, on rings of walking time</title>
      {%- for r in n | mapRings(560) %}<circle class="rm-ring" cx="280" cy="280" r="{{ r.r }}"/><text class="rm-rl" x="280" y="{{ 280 - r.r + 16 }}" text-anchor="middle">{{ r.minutes }} min</text>{% endfor %}
      <circle class="rm-home" cx="280" cy="280" r="9"/><text class="rm-hl" x="280" y="306" text-anchor="middle">{{ n.centre.label }}</text>
      {%- for p in pts %}<g class="rm-p"><circle cx="{{ p.cx }}" cy="{{ p.cy }}" r="13"/><text x="{{ p.cx }}" y="{{ p.cy + 5 }}" text-anchor="middle">{{ loop.index }}</text></g>{% endfor %}
    </svg>
    <figcaption>Rings at walking time from the door, as the crow flies, allowing for streets. Not to scale for any route.</figcaption>
  </figure>
  <ol class="rm-l">
    {%- for p in pts %}<li><b>{{ p.name }}</b> <span>{{ p.kind }}</span><span class="rm-w">{{ p | walkText }}</span>{% if p.note %}<p>{{ p.note }}</p>{% endif %}</li>{% endfor %}
  </ol>
  <p class="rm-fine">Places chosen by {{ site.business.name }}, checked {{ n.checked | monthYear }}. Times marked "about" are estimated from the distance; the rest are walked.</p>
</div>
