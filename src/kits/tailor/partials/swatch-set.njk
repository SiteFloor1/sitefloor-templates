{#- The swatch set: up to five cloths asked for in one WhatsApp message. Filled by cloth-book.js; hidden while empty. -#}
<div class="tl-set" data-cb-set hidden aria-live="polite">
  <p class="tl-set-t"><span data-cb-set-names></span> <span class="tl-set-n" data-cb-set-count></span></p>
  <p class="tl-set-acts"><a class="tl-btn" data-cb-set-ask href="{{ site.cloths.message | book }}" target="_blank" rel="noopener">Ask for these swatches</a><button type="button" class="tl-quiet" data-cb-set-clear>Clear</button></p>
</div>
