{#- What to wear, class by class: the photograph in a circle, the classes as a row of words to tap, and the list for the
    one chosen; the supplier's link beneath. Every list is in the page, so it reads without JavaScript. -#}
{%- set u = site.uniform %}
{%- set sec = site.sections.uniform %}
<section id="uniform" class="bt-uni{% if uniformPage %} bt-uni-page{% endif %}" data-feature="ballet-uniform"{{ "ballet-uniform" | tierAttr | safe }}><div class="wrap bt-uni-in">
  <figure class="bt-uni-photo rd-round rv"><img src="{{ u.photo.src | img }}" alt="{{ u.photo.alt }}" width="{{ u.photo.width }}" height="{{ u.photo.height }}" loading="lazy" decoding="async"></figure>
  <div class="bt-uni-text">
    {%- if not uniformPage %}{% include "core/partials/section-head.njk" %}{% endif %}
    <div class="bt-tabs" role="tablist" aria-label="Class">
      {%- for s in u.sets %}<button type="button" role="tab" id="uni-t-{{ s.id }}" aria-controls="uni-p-{{ s.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ s.name }}</button>{% endfor %}
    </div>
    {%- for s in u.sets %}
    <div class="bt-uni-set" role="tabpanel" id="uni-p-{{ s.id }}" aria-labelledby="uni-t-{{ s.id }}"{% if not loop.first %} hidden{% endif %}>
      {%- if s.classes.length %}<p class="rd-fine">For {{ s.classes | classNames(site.classes.items) }}</p>{% endif %}
      <ul class="bt-items">{% for x in s.items %}<li><span>{{ x.name }}</span>{% if x.note %}<em>{{ x.note }}</em>{% endif %}</li>{% endfor %}</ul>
    </div>
    {%- endfor %}
    {%- if u.shop %}<p><a class="rd-link" href="{{ u.shop.url }}" target="_blank" rel="noopener">{{ u.shop.label }}</a></p>{% endif %}
    {%- if u.note %}<p class="rd-fine">{{ u.note }}</p>{% endif %}
    {%- if not uniformPage %}<p><a class="rd-link" href="{{ 'uniform' | href }}">Every class's list</a></p>{% endif %}
  </div>
</div></section>
