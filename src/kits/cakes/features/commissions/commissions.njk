{#- The studio's cakes, numbered like a collection: each large, with its tiers, servings and "from" price. The home
    page shows three (not the hero's own cake, already on the screen) and links to the rest when the commission pages
    are on; the commissions page shows them all. -#}
{%- set sec = site.sections.pieces %}
<section id="commissions" class="ck-pieces" data-feature="commissions" aria-label="{{ sec.title | plain }}"{{ 'commissions' | tierAttr | safe }}><div class="wrap">
  {%- include "core/partials/section-head.njk" %}
  {%- set list = pieceList or ((site | homePieces) if pageId == "index" else site.pieces.items) %}
  <ul class="ck-pieces-l{% if pageId == "index" %} ck-pieces-home{% endif %}">
    {%- for p in list %}
    <li class="ck-piece rv">
      {%- if 'commission-pages' | enabled %}<a class="ck-piece-a" href="{{ ('commission-' + p.id) | href }}">{% else %}<div class="ck-piece-a">{% endif %}
        <img src="{{ p.photo.src | img }}" alt="{{ p.photo.alt }}" width="{{ p.photo.width }}" height="{{ p.photo.height }}" loading="lazy" decoding="async">
        <span class="ck-piece-t">{% if p.no %}<span class="ck-no">No. {{ p.no }}</span>{% endif %}<b>{{ p.name }}</b></span>
        <span class="ck-piece-s">{{ p.sizes.length | tiersWords }}, serves {{ p.serves }} · from {{ p.from | gbp }}</span>
      {%- if 'commission-pages' | enabled %}</a>{% else %}</div>{% endif %}
    </li>
    {%- endfor %}
  </ul>
  {%- if ('commission-pages' | enabled) and pageId == "index" %}<p class="ck-more"><a class="go" href="{{ 'commissions' | href }}">All {{ site.pieces.items.length }} commissions</a></p>{% endif %}
</div></section>
