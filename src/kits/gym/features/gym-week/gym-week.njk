{#- The timetable page: a day at a time (today first), the day's classes and how busy the club usually is, hour by
    hour, drawn as fine rules (each hour's usual count against the day's busiest), the hour now marked on today. -#}
{%- set days = site.timetable.weekly | weekOf(site.hours, build.today, 7) %}
<section class="gw" data-feature="gym-week" aria-label="This week"><div class="wrap">
  <div class="gw-tabs" role="tablist" aria-label="Day">
    {%- for d in days %}<button type="button" role="tab" id="gw-t{{ loop.index0 }}" aria-controls="gw-p{{ loop.index0 }}" aria-selected="{{ 'true' if loop.first else 'false' }}" data-date="{{ d.date }}"{% if not loop.first %} tabindex="-1"{% endif %}>{% if loop.first %}Today{% elif loop.index == 2 %}Tomorrow{% else %}{{ d.weekday | dayName }}{% endif %}</button>{% endfor %}
  </div>
  {%- for d in days %}{% set key = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"][d.weekday] %}{% set b = site.busy | busyDay(key) %}
  <div class="gw-p" role="tabpanel" id="gw-p{{ loop.index0 }}" aria-labelledby="gw-t{{ loop.index0 }}" data-date="{{ d.date }}"{% if not loop.first %} hidden{% endif %}>
    <div class="gw-busy">
      <h2 class="gw-h">How busy it usually is, {{ d.date | ukDay }}</h2>
      <p class="gw-words">{{ b.words }}</p>
      {%- if b.hours.length %}
      <div class="gw-rules" role="img" aria-label="{{ b.words }}">
        {%- for x in b.hours %}<span class="gw-r" data-h="{{ x.h }}" style="--p:{{ x.pct }}%"><i></i>{% if x.h % 3 == 0 %}<b>{{ x.label }}</b>{% endif %}</span>{% endfor %}
      </div>
      <p class="gw-src">The club's own door counts, averaged; "usually", never live.</p>
      {%- endif %}
    </div>
    <div class="gw-classes">
      <h2 class="gw-h">Classes</h2>
      {%- if d.sessions.length %}
      <ol class="gt-list">
        {%- for s in d.sessions %}{% set c = site | classOf(s.class) %}
        <li class="gt-s" data-key="{{ d.date }} {{ s.time }} {{ s.class }}" data-time="{{ s.time }}"><time datetime="{{ d.date }}T{{ s.time }}">{{ s.time }}</time><div class="gt-what"><h3>{{ c.name }}</h3><p>{{ c.minutes }} minutes{% if s.room %} · {{ s.room }}{% endif %}{% if s.coach %} · with {{ s.coach }}{% endif %}</p></div><span class="gt-left" data-left hidden></span>{% set bk = s.url %}{% include "kits/gym/partials/book.njk" %}</li>
        {%- endfor %}
      </ol>
      {%- else %}<p class="gt-none">No classes this day.</p>{% endif %}
    </div>
  </div>
  {%- endfor %}
  {%- if "gym-spaces" | enabled %}<span data-feature="gym-spaces" hidden></span>{% endif %}
</div></section>
