{#- Delivery areas (Plus): every district the florist delivers to by hand, each area's own cut-off and charge, and
    how delivery works in their words. Each area has its own page. -#}
{%- set DA = site.deliveryAreas %}
{%- set ph = { kicker: DA.kicker or "Delivery", title: DA.title, intro: DA.intro } %}
{% include "kits/florist/partials/page-head.njk" %}
<section class="fl-areas" aria-label="Areas"><div class="wrap">
  <ul class="fl-areas-l" role="list">
    {%- for a in DA.areas %}
    <li><a class="fl-area-a" href="{{ ('delivery-' + (a.district | lower)) | href }}">
      <b class="fl-area-d">{{ a.district }}</b><span class="fl-area-n">{{ a.name }}</span>
      <span class="fl-area-c">{{ site.delivery | areaCutoffs(a) | cutoffGroups }}</span>
      <span class="fl-area-f">{% set fee = a.fee if a.fee is defined else site.delivery.fee %}{% if fee is defined %}{{ "Free" if fee == 0 else (fee | pounds) }}{% endif %}</span></a></li>
    {%- endfor %}
  </ul>
  <p class="fl-areas-else">{{ site.delivery.collect }}</p>
</div></section>
{%- if DA.how %}
<section class="fl-how" aria-labelledby="dhow-h"><div class="wrap">
  <h2 id="dhow-h">How delivery works</h2>
  <dl class="fl-how-l">{% for h in DA.how %}<div><dt>{{ h.q }}</dt><dd>{{ h.a }}</dd></div>{% endfor %}</dl>
</div></section>
{%- endif %}
