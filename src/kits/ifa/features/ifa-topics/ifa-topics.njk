{#- A subject's page: general information (dated and sourced), whether the FCA regulates this advice, how the firm helps,
    what to bring, the milestones on the pensions page, then the way to a first meeting. -#}
{%- include "kits/ifa/partials/meet-href.njk" %}
{%- set svc = (site.advice.items | selectattr("topic", "equalto", t.id) | first) %}
{%- set ph = { title: t.title, intro: t.intro, crumbHref: ('services' | href), crumbLabel: site.sections.services.title } %}
{% include "kits/ifa/partials/page-head.njk" %}
{%- if t.photo %}<figure class="wrap if-tp-fig"><img src="{{ t.photo.src | img }}" alt="{{ t.photo.alt }}" width="{{ t.photo.width }}" height="{{ t.photo.height }}" decoding="async"{% if t.photo.position %} style="object-position:{{ t.photo.position }}"{% endif %}>{% if t.photo.credit %}<figcaption>{{ t.photo.credit }}</figcaption>{% endif %}</figure>{% endif %}
<section class="if-tp" data-feature="ifa-topics"><div class="wrap if-tp-in">
  <div class="if-tp-body">
    {%- for p in t.body %}<p>{{ p }}</p>{% endfor %}
    {%- if not t.regulated %}<p class="if-tp-reg">{{ site.regulation.unregulated }}</p>{% endif %}
    <p class="if-fine">General information, not advice. Checked {{ t.checked | ukDate }}: {% for s in t.sources %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.</p>
  </div>
  <aside class="if-tp-side">
    <h2>How we help</h2>
    <ul>{% for h in t.help %}<li>{{ h }}</li>{% endfor %}</ul>
    {%- if svc %}<h2>What to bring</h2><ul class="if-svc-b">{% for b in svc.bring %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
    <a class="if-btn" href="{{ meetHref }}">Book a first meeting</a>
  </aside>
</div></section>
{%- if ("ifa-milestones" | enabled) and site.milestones.topic == t.id %}{% include "kits/ifa/features/ifa-milestones/ifa-milestones.njk" %}{% endif %}
