{#- The inspection light: the studio's own matched pair, one panel under the same light and framing, before and
    after. The before photograph fills the box; the after shows only inside the beam the visitor drags. Included by a
    look's hero when the feature is on; the words and actions are the look's. -#}
{%- set ins = site.inspection %}
<figure class="dt-il" data-feature="inspection-light" style="--x: 58%">
  <img class="dt-il-b" src="{{ ins.before.src | img }}" alt="{{ ins.alt }}" width="{{ ins.before.width }}" height="{{ ins.before.height }}" fetchpriority="high" decoding="async">
  <img class="dt-il-a" src="{{ ins.after.src | img }}" alt="" width="{{ ins.after.width }}" height="{{ ins.after.height }}" decoding="async">
  <span class="dt-il-lamp" aria-hidden="true"></span>
  <span class="dt-il-h" role="slider" tabindex="0" aria-label="Move the inspection light" aria-valuemin="0" aria-valuemax="100" aria-valuenow="58" data-il-handle><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span>
  <figcaption class="dt-il-c">{{ ins.caption }}</figcaption>
</figure>
