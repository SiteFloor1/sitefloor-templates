{#- The wedding date as day, month and year, always in UK order whatever the phone's language. Set `df` = a short
    id prefix and `dfLabel` = the legend first. Filled in by partials/date-field.js. -#}
<fieldset class="bd-date" data-date-field>
  <legend class="bd-k">{{ dfLabel or "Your wedding" }}</legend>
  <div class="bd-date-in">
    <label class="sr-only" for="{{ df }}-d">Day</label>
    <select id="{{ df }}-d" data-d><option value="">Day</option>{% for d in range(1, 32) %}<option value="{{ d }}">{{ d }}</option>{% endfor %}</select>
    <label class="sr-only" for="{{ df }}-m">Month</label>
    <select id="{{ df }}-m" data-m><option value="">Month</option>{% for m in ["January","February","March","April","May","June","July","August","September","October","November","December"] %}<option value="{{ loop.index }}">{{ m }}</option>{% endfor %}</select>
    <label class="sr-only" for="{{ df }}-y">Year</label>
    <select id="{{ df }}-y" data-y><option value="">Year</option>{% for y in build.today | yearsFrom(4) %}<option value="{{ y }}">{{ y }}</option>{% endfor %}</select>
  </div>
</fieldset>
