{#- The mirror: a gown seen from every side the salon photographed, in three panes as in the fitting room. Opened from
    a gown's "Every side"; the panes are filled from that gown's photographs. -#}
<dialog class="bd-mirror" data-feature="gown-mirror" aria-labelledby="gm-h">
  <div class="bd-mirror-in">
    <div class="bd-mirror-top">
      <p id="gm-h" class="bd-mirror-h" data-gm-name>The mirror</p>
      <button type="button" class="bd-quiet" data-gm-close>Close</button>
    </div>
    <div class="bd-mirror-panes" data-gm-panes></div>
    <p class="bd-mirror-more" data-gm-more></p>
  </div>
</dialog>
