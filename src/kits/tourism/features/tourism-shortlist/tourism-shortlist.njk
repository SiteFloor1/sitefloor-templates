{#- Keep on a journey page, and the shortlist beneath it (the home page's journeys carry their own Keep). Needs `j`. -#}
<span data-feature="tourism-shortlist"{{ "tourism-shortlist" | tierAttr | safe }}><button class="tj-keep" type="button" data-keep="{{ j.id }}" aria-pressed="false">Keep</button>
      <span class="tj-short" data-shortlist hidden><span data-short-words></span> <a class="tj-send" data-short-send href="{{ site.messages.general | wa }}" target="_blank" rel="noopener">Send the list on WhatsApp</a> <button class="tj-clear" type="button" data-short-clear>Clear</button></span></span>
