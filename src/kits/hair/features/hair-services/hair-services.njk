{#- Services and prices: the level chooser once, then each group of the menu as a price grid by length. Jump links to
    each group. Works without JavaScript (the level is a radio the tables read). -#}
{%- set ph = { title: site.servicesPage.title, intro: site.servicesPage.intro, photo: site.servicesPage.photo } %}
{% include "kits/hair/partials/page-head.njk" %}
<section class="hr-sp" aria-label="Prices"><div class="wrap">
  <div class="hr-sp-top">
    {% include "kits/hair/partials/level-pick.njk" %}
    <nav class="hr-sp-jump" aria-label="Groups">{% for g in site.menu.groups %}<a href="#g-{{ g.id }}">{{ g.name }}</a>{% endfor %}</nav>
  </div>
  {%- for g in site.menu.groups %}
  <div class="hr-sp-g" id="g-{{ g.id }}">
    <h2 class="hr-sp-h">{{ g.name }}</h2>
    {%- if "group-pages" | enabled %}{% for gp in site.groupPages.items %}{% if gp.group == g.id %}<p class="hr-sp-more"{{ "group-pages" | tierAttr | safe }}><a class="hr-go" href="{{ gp.slug | href }}">{{ gp.title }}, in full</a></p>{% endif %}{% endfor %}{% endif %}
    {%- set ptGroup = g.id %}{% include "kits/hair/partials/price-table.njk" %}
  </div>
  {%- endfor %}
  {%- if site.menu.note %}<p class="hr-small hr-sp-note">{{ site.menu.note }}</p>{% endif %}
  <p class="hr-sp-go"><a class="hr-btn" href="{{ site.menu.message | book }}" target="_blank" rel="noopener">Ask on WhatsApp</a></p>
</div></section>
{%- set hostPage = "hair-services" %}{% include "kits/hair/partials/hosted.njk" %}
