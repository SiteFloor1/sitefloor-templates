{#- The practice page: an index of the areas pinned at the side; each area opens with its own photograph and its name
    set large across the photograph's foot, then what the firm does, who leads it and what to read, a strip of honest
    facts (a published price and timescale, the question clients ask most), the matter step by step and, where it
    belongs, the will review reminder. -#}
{%- set ph = { title: "Practice", intro: (site.sections.practice.intro if site.sections.practice else "") } %}
{% include "kits/law/partials/page-head.njk" %}
<div class="wrap lw-pp">
  <nav class="lw-pp-nav" aria-label="Practice areas"><ol>{% for a in site.practice.items %}<li><a href="#{{ a.id }}">{{ a.name }}</a></li>{% endfor %}</ol></nav>
  <div class="lw-pp-areas">
  {%- for a in site.practice.items %}{% set lead = site.people | person(a.lead) %}{% set f = a | areaFacts(site) %}
  <section class="lw-pp-a" id="{{ a.id }}" aria-labelledby="pp-{{ a.id }}">
    {%- if a.photo %}
    <figure class="lw-pp-fig"><img src="{{ a.photo.src | img }}" alt="{{ a.photo.alt }}" width="{{ a.photo.width }}" height="{{ a.photo.height }}"{% if not loop.first %} loading="lazy"{% endif %} decoding="async"{% if a.photo.position %} style="object-position:{{ a.photo.position }}"{% endif %}>
      <figcaption><h2 class="lw-pp-t" id="pp-{{ a.id }}">{{ a.name }}</h2></figcaption></figure>
    {%- else %}<h2 class="lw-pp-t lw-pp-t-plain" id="pp-{{ a.id }}">{{ a.name }}</h2>{% endif %}
    <p class="lw-pp-about">{{ a.about }}</p>
    <div class="lw-pp-cols">
      <div><h3>What we do</h3><ul>{% for d in a.does %}<li>{{ d }}</li>{% endfor %}</ul></div>
      <div><h3>Who leads it</h3><p><b>{{ lead.name }}</b><br>{{ lead.role }}</p>
        <p class="lw-pp-c">{% if lead.phone %}<a href="tel:{{ lead.phone | replace(' ', '') }}">{{ lead.phone }}</a><br>{% endif %}<a href="mailto:{{ lead.email }}">{{ lead.email }}</a></p>
        {%- set others = site.people | peopleIn(a.id, a.lead) %}{% if others.length %}<p class="lw-pp-w">With {{ others | names | andList }}.</p>{% endif %}</div>
      <div><h3>To read</h3>
        {%- set gl = (site.guides.items | byArea(a.id)) if ("guides-page" | enabled) else [] %}{% set il = (site.insights.items | byArea(a.id)) if ("insights-page" | enabled) else [] %}
        {%- if gl.length or il.length %}<ul class="lw-pp-reads">{% for r in gl %}<li><a href="{{ r.id | href }}">{{ r.title }}</a></li>{% endfor %}{% for r in il %}<li><a href="{{ r.id | href }}">{{ r.title }}</a></li>{% endfor %}</ul>
        {%- else %}<p class="lw-pp-w">Ask {{ lead.name.split(" ")[0] }} for our notes on this.</p>{% endif %}
        {%- if "area-pages" | enabled %}<p><a class="go" href="{{ a.id | href }}"{{ 'area-pages' | tierAttr | safe }}>{{ a.name }} in full</a></p>{% endif %}</div>
    </div>
    {%- if f.price or f.asked %}
    <dl class="lw-pp-facts">
      {%- if f.price %}<div><dt>{{ f.name }}</dt><dd>{{ f.price }} before VAT · <a href="{{ 'pricing' | href }}#{{ f.service }}">what's included</a></dd></div>
      <div><dt>Usually takes</dt><dd>{{ f.timescale }}</dd></div>{% endif %}
      {%- if f.asked %}<div><dt>{{ f.asked.q }}</dt><dd>{{ f.asked.a }}</dd></div>{% endif %}
    </dl>
    {%- endif %}
    {%- if "matter-steps" | enabled %}{% set stepsArea = a.id %}{% include "kits/law/features/matter-steps/matter-steps.njk" %}{% endif %}
    {%- if ("will-reminder" | enabled) and site.willReminder.practice == a.id %}{% include "kits/law/features/will-reminder/will-reminder.njk" %}{% endif %}
  </section>
  {%- endfor %}
  </div>
</div>
