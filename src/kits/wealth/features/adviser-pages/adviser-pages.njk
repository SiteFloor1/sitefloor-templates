{#- An adviser's own page: a photograph (at a distance or a portrait), what they look after, their FCA reference with
    a link to check it, how to reach them, and a booking link (their booking app, or the meeting page with them chosen). `p` is the adviser. -#}
{%- set book = p.book or (((('meeting' | href) + '#with-' + p.id)) if ('meeting' | enabled) else 'tel:' + ((p.phone or site.contact.phone) | replace(' ', ''))) %}
<article class="wm-adv" data-feature="adviser-pages">
  <div class="wrap wm-adv-in">
    <div class="wm-adv-t">
      <p class="wm-crumb"><a href="{{ 'index' | href }}">{{ site.business.name }}</a>{% if 'advisers-page' | enabled %} <span aria-hidden="true">/</span> <a href="{{ 'people' | href }}">{{ site.sections.advisers.title }}</a>{% endif %}</p>
      <h1 class="wm-ph-t">{{ p.name }}</h1>
      <p class="wm-ph-i">{{ p.role }}</p>
      {%- if p.note %}<p class="wm-adv-note">{{ p.note }}</p>{% endif %}
      {%- set looks = p.leads or [] %}
      {%- if looks.length and site.lifeEvents %}
      <h2>Looks after</h2>
      <ul class="wm-le-l">{% for id in looks %}{% set ev = site.lifeEvents | lifeEvent(id) %}{% if ev %}<li>{% if 'life-events' | enabled %}<a href="{{ ev.id | href }}">{{ ev.title }}</a>{% else %}{{ ev.title }}{% endif %}</li>{% endif %}{% endfor %}</ul>
      {%- endif %}
      <dl class="wm-adv-dl">
        {%- if p.irn %}<dt>FCA reference</dt><dd>{{ p.irn }}{{ site.mode | demoTag }} <a href="{{ fca.register }}" target="_blank" rel="noopener">Check the register</a></dd>{% endif %}
        {%- if p.phone %}<dt>Direct line</dt><dd><a href="tel:{{ p.phone | replace(' ', '') }}">{{ p.phone | replace('+44 ', '0') }}</a></dd>{% endif %}
        {%- if p.email %}<dt>Email</dt><dd><a href="mailto:{{ p.email }}">{{ p.email }}</a></dd>{% endif %}
      </dl>
      <p class="wm-adv-go"><a class="wm-btn" href="{{ book }}"{% if p.book %} target="_blank" rel="noopener"{% endif %}>Book time with {{ p.name.split(" ")[0] }}</a></p>
    </div>
    {%- if p.photo %}<figure class="wm-adv-fig"><img src="{{ p.photo.src | img }}" alt="{{ p.photo.alt }}" width="{{ p.photo.width }}" height="{{ p.photo.height }}" fetchpriority="high" decoding="async"{% if p.photo.position %} style="object-position:{{ p.photo.position }}"{% endif %}></figure>{% endif %}
  </div>
</article>
