{#- An inner page's opening: its name, heavy and close; its line beneath. Set `ph` to { title, intro } first. -#}
<header class="ph st-ph"><div class="wrap">
  <h1 class="st-ph-t">{{ ph.title | markup | safe }}</h1>
  {%- if ph.intro %}<p class="st-ph-i">{{ ph.intro }}</p>{% endif %}
</div></header>
