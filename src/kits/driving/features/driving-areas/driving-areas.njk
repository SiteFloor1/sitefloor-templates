{#- Do you cover me? (DRIVE-1): a postcode against the instructor's own districts. Every district is printed under the
    box, so the answer is there without JavaScript. -#}
{%- set a = site.areas %}
<article class="dv-card dv-areas" id="areas" data-feature="driving-areas" aria-labelledby="da-h"{{ 'driving-areas' | tierAttr | safe }}>
  <button class="dv-mh" type="button" aria-expanded="false" data-dv-open><span>{{ a.title }}</span><em>{{ a.districts | length }} areas</em></button>
  <div class="dv-body">
  <h2 class="dv-ct" id="da-h">{{ a.title }}{% if site.mode == "demo" %} <span class="dv-tag">Sample</span>{% endif %}</h2>
  <form class="dv-pc" data-da-form>
    <label class="sr-only" for="da-pc">Your postcode</label>
    <input id="da-pc" type="text" inputmode="text" autocomplete="postal-code" autocapitalize="characters" spellcheck="false" maxlength="8" placeholder="Your postcode" data-da-pc>
    <button type="submit">Check</button>
  </form>
  <p class="dv-ans" data-da-out aria-live="polite"></p>
  <noscript><style>.dv-areas .dv-pc { display: none; }</style></noscript>
  <p class="dv-cover">{% if a.pickup %}{{ a.pickup }} {% endif %}{% for d in a.districts %}{{ d.district }}{{ ", " if not loop.last and loop.revindex > 2 else (" and " if loop.revindex == 2 else ".") }}{% endfor %}</p>
  </div>
</article>
