{#- One fragrance's sizes and how to buy: the sizes as choices (drawn to scale when "sizes side by side" is on), then
    Buy for the chosen size (the house's Stripe link, or the order on WhatsApp) and the sample. `x` is the fragrance.
    Without JavaScript the middle size is chosen and its link works. -#}
{%- set s0 = x | defaultSize %}
{%- set drawn = ("fragrance-sizes" | enabled) and not plainSizes %}
<div class="fr-buy" data-scent="{{ x.id }}">
  <div class="fr-sizes{% if drawn %} fr-drawn{% endif %}" role="radiogroup" aria-label="Size of {{ x.name }}">
    {%- for s in x.sizes %}
    <label class="fr-size"><input type="radio" name="size-{{ x.id }}{{ buyKey or '' }}" value="{{ s.ml }}"{% if s.ml == s0.ml %} checked{% endif %}>
      {%- if drawn %}<span class="fr-flacon" style="--s: {{ s | sizeScale(x.sizes) }}" aria-hidden="true"></span>{% endif %}
      <span class="fr-size-ml">{{ s.ml }} ml</span>
      {%- if drawn %}<span class="fr-size-p">{{ s.price | gbp }}<small>{{ s | per10ml }} per 10 ml</small></span>{% endif %}
    </label>
    {%- endfor %}
  </div>
  <a class="fr-go" data-buy href="{{ s0.payLink if s0.payLink else (site.fragrances.message | orderText(x, s0, site.business.name) | book) }}" target="_blank" rel="noopener">Buy, {{ s0.price | gbp }}</a>
  {%- if x.sample %}
  {%- set sm = { ml: x.sample.ml, price: x.sample.price } %}
  <a class="fr-alt" data-sample href="{{ x.sample.payLink if x.sample.payLink else ((site.fragrances.sampleMessage or site.fragrances.message) | orderText(x, sm, site.business.name) | book) }}" target="_blank" rel="noopener">or try a sample, {{ x.sample.price | gbp }}</a>
  {%- endif %}
</div>
