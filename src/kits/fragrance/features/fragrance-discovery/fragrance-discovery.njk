{#- Discovery sets (FRAG-3): choose the house's number of samples; the set shows as it fills; pay by the house's own
    Stripe link and send the choice on WhatsApp, or order the set on WhatsApp. The terms in the house's words. -#}
{%- set d = site.discovery %}
{%- set ph = { title: d.title, intro: d.intro } %}
{% include "kits/fragrance/partials/page-head.njk" %}
<section class="fr-disc" data-feature="fragrance-discovery" aria-label="{{ d.title | plain }}"><div class="wrap fr-disc-in">
  <form class="fr-disc-f" data-disc-form>
    <fieldset><legend class="fr-disc-lg">Choose {{ d.pick }}, {{ d.ml }} ml each</legend>
      <ul class="fr-disc-list">
        {%- for x in site.fragrances.items %}
        <li><label class="fr-disc-o"><input type="checkbox" name="pick" value="{{ x.id }}">
          <img src="{{ x.photo.src | img }}" width="{{ x.photo.width }}" height="{{ x.photo.height }}" alt="" loading="lazy" decoding="async">
          <span><b>{{ x.name }}</b><small>{{ x.line }}</small></span></label></li>
        {%- endfor %}
      </ul>
    </fieldset>
  </form>
  <aside class="fr-disc-side">
    <p class="fr-disc-count" data-disc-count aria-live="polite" data-js-only>0 of {{ d.pick }} chosen</p>
    <ol class="fr-disc-set" data-disc-set aria-label="Your set">{% for i in range(0, d.pick) %}<li class="fr-vial"></li>{% endfor %}</ol>
    <a class="fr-go" data-disc-go href="{{ d.payLink if d.payLink else (d.message | orderText({ name: '' }, { ml: d.ml, price: d.price }, site.business.name) | book) }}" target="_blank" rel="noopener">Order the set, {{ d.price | gbp }}</a>
    <a class="fr-alt" data-disc-send href="{{ d.message | orderText({ name: '' }, { ml: d.ml, price: d.price }, site.business.name) | book }}" target="_blank" rel="noopener"{% if not d.payLink %} hidden{% endif %}>then send us your choice on WhatsApp</a>
    <p class="fr-small">{{ d.terms }}</p>
  </aside>
</div></section>
