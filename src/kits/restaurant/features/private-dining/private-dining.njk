{#- Private dining: rooms with guest numbers and minimum spend, set menus per head with the total for the
    group, and an enquiry on WhatsApp. The Room's plan sits here too on Signature. -#}
{%- set pd = site.privateDining %}
<section class="phero"><div class="wrap">
  <span class="kick">{{ pd.kicker }}</span>
  <h1>{{ pd.title | markup | safe }}</h1>
  <p>{{ pd.intro }}</p>
</div></section>
<section class="pd" data-feature="private-dining"><div class="wrap">
  <ul class="pd-rooms">
    {%- for r in pd.rooms %}
    <li class="pd-room" data-pd-room="{{ r.id }}" data-min="{{ r.minSpend or 0 }}" data-seats="{{ r.seats[0] }}-{{ r.seats[1] }}">
      {%- if r.photo %}<img src="{{ r.photo.src | img }}" width="{{ r.photo.width }}" height="{{ r.photo.height }}" alt="{{ r.photo.alt }}" loading="lazy">{% endif %}
      <div class="pd-text">
        <h2>{{ r.name }}</h2>
        <p class="pd-facts"><span>{{ r.seats[0] }}–{{ r.seats[1] }} guests</span>{% if r.minSpend %}<span>Minimum spend {{ r.minSpend | gbp }}</span>{% else %}<span>No minimum spend</span>{% endif %}</p>
        <p>{{ r.text }}</p>
      </div>
    </li>
    {%- endfor %}
  </ul>
  {%- if pd.menus %}
  <div class="pd-menus">
    <h2 class="pd-h">Set menus</h2>
    <ul class="pd-menu-list">
      {%- for mm in pd.menus %}
      <li data-pd-menu="{{ mm.id }}" data-price="{{ mm.price }}"><div class="rs-row"><span class="rs-name">{{ mm.name }}</span><span class="rs-dots" aria-hidden="true"></span><span class="rs-price">{{ mm.price | gbp }} a head</span></div><ul class="pd-courses">{% for c in mm.courses %}<li>{{ c }}</li>{% endfor %}</ul></li>
      {%- endfor %}
    </ul>
  </div>
  {%- endif %}
  <form class="pd-ask" data-pd-form data-js-only>
    <h2 class="pd-h">Ask about a date</h2>
    <div class="pd-fields">
      <label class="rs-field">Guests<input type="number" inputmode="numeric" min="1" max="200" value="14" data-pd-guests></label>
      <label class="rs-field">Date<input type="date" data-pd-date></label>
      <label class="rs-field">Room<select data-pd-roomsel>{% for r in pd.rooms %}<option value="{{ r.id }}">{{ r.name }}</option>{% endfor %}</select></label>
      {%- if pd.menus %}<label class="rs-field">Menu<select data-pd-menusel><option value="">Not sure yet</option>{% for mm in pd.menus %}<option value="{{ mm.id }}">{{ mm.name }} ({{ mm.price | gbp }})</option>{% endfor %}</select></label>{% endif %}
    </div>
    <p class="pd-sum" data-pd-sum aria-live="polite">&nbsp;</p>
    <a class="btn" data-pd-send href="{{ pd.message | wa }}" target="_blank" rel="noopener">{% include "core/partials/icon-whatsapp.njk" %}Send the enquiry</a>
    {%- if pd.note %}<p class="rs-small">{{ pd.note }}</p>{% endif %}
  </form>
  <p data-no-js><a class="btn" href="{{ pd.message | wa }}" target="_blank" rel="noopener">Message us about private dining</a></p>
</div></section>
