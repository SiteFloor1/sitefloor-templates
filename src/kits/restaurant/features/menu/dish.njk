{#- One dish on a menu. Expects `d` (a dish). Its diets and allergens travel as data attributes for the
    filters, The Table and the takeaway tray. -#}
<li class="rs-dish" data-dish="{{ d.id }}" data-name="{{ d.name }}" data-price="{{ d.price }}" data-diets="{{ (d.diets or []) | join(' ') }}" data-allergens="{{ d.allergens | join(' ') }}">
  <div class="rs-row"><span class="rs-name">{{ d.name }}</span><span class="rs-dots" aria-hidden="true"></span><span class="rs-price"><span class="sr-only">£</span>{{ d.price | menuPrice }}</span></div>
  {%- if d.desc %}<p class="rs-desc">{{ d.desc }}</p>{% endif %}
  <p class="rs-meta">
    {%- for mk in d | dietMarks %}<abbr class="rs-mark" title="{{ mk.name }}">{{ mk.mark }}</abbr>{% endfor %}
    {%- if d.spice %}<span class="rs-spice" role="img" aria-label="{{ food.spice[d.spice] }}">{% for i in range(0, d.spice) %}<svg viewBox="0 0 11 13" aria-hidden="true"><path d="M6.6 1.2c.6.3.7 1 .4 1.6 1.7.4 2.7 2 2.3 4-.5 2.4-2.6 4.9-6.6 5.6-.6.1-.8-.6-.3-.9 2-1.4 2.6-3.4 2.8-5.1.1-1.3.7-2.6 1.6-3.1-.5-.5-.6-1.5-.2-2.1Z" fill="currentColor"/></svg>{% endfor %}</span>{% endif %}
    {%- set an = d | allergenNames %}
    <span class="rs-all">{% if an.length %}Contains: {{ an | join(", ") | lower }}{% else %}None of the 14 allergens{% endif %}</span>
    <span class="rs-out" data-out hidden>Sold out today</span>
  </p>
  {%- if ("pairings" | enabled) and d.pairs %}<p class="rs-pairs">Goes with: {% for p in d.pairs %}{% set dr = site.menu | dish(p) %}{{ dr.name }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
</li>
