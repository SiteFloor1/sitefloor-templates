{#- Can I work here? The café's own answers on wifi, sockets, laptops, dogs, children, buggies, access and toilets,
    like a hotel's card; today's laptop-friendly hours from its own busyness numbers (with JavaScript); its photos
    and house rules. -#}
{%- set sec = site.sections.workHere %}
{%- set w = site.workHere %}
{%- set NAMES = { "wifi": "Wifi", "sockets": "Sockets", "laptops": "Laptops", "dogs": "Dogs", "kids": "Children", "buggies": "Buggies", "step-free": "Step-free", "toilet": "Toilet", "accessible-toilet": "Accessible toilet", "baby-change": "Baby changing", "outside": "Seats outside" } %}
{%- set ICONS = {
  "wifi": "M3 9.5a13 13 0 0 1 18 0M6 13a8.5 8.5 0 0 1 12 0M9 16.4a4 4 0 0 1 6 0M12 19.6h.01",
  "sockets": "M7 3v5M17 3v5M5 8h14v4a7 7 0 0 1-14 0zM12 19v3",
  "laptops": "M5 6h14v9H5zM3 18h18",
  "dogs": "M7 10c0-3 2-5 5-5s5 2 5 5v3c0 3-2 6-5 6s-5-3-5-6zM7 10 4 7v5M17 10l3-3v5M10 12h.01M14 12h.01M11 15h2",
  "kids": "M12 7a2.5 2.5 0 1 0 0-.01M8 21l1.5-8h5L16 21M7 11l5 2 5-2",
  "buggies": "M4 6h4l3 7h8a5 5 0 0 0-5-5h-3M7 19a2 2 0 1 0 0-.01M17 19a2 2 0 1 0 0-.01M11 13l-2 4h8",
  "step-free": "M12 4.5a1.5 1.5 0 1 0 0-.01M11 8v6h5l2 5M11 11h5M9 11.5a5 5 0 1 0 6.5 7",
  "toilet": "M6 4h12v6H6zM7 10c0 4 2 6 5 6s5-2 5-6M10 16l-1 4h6l-1-4",
  "accessible-toilet": "M6 4h5v6H6zM6 10c0 3 1 5 3 5M14 6.5a1.5 1.5 0 1 0 0-.01M14 9v4h4l1.5 4M14 11h4M12.5 12a4 4 0 1 0 4.5 5.5",
  "baby-change": "M4 15h16v3H4zM9 12a2 2 0 1 0 0-.01M12 12h5",
  "outside": "M12 3v2M12 19v2M4.2 7l1.7 1M18.1 16l1.7 1M3 12h2M19 12h2M4.2 17l1.7-1M18.1 8l1.7-1M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8"
} %}
<section id="work-here" class="wh" data-feature="work-here" aria-labelledby="wh-h"{{ "work-here" | tierAttr | safe }}><div class="wrap">
  <div class="sh rv"><div>{% if sec.kicker %}<span class="kick">{{ sec.kicker }}</span>{% endif %}<h2 id="wh-h">{{ sec.title | markup | safe }}</h2></div>{% if sec.intro %}<p>{{ sec.intro }}</p>{% endif %}</div>
  <div class="wh-grid">
    <div class="wh-card">
      <ul class="wh-list">
        {%- for a in w.answers %}
        <li class="wh-{{ a.answer }}">
          <svg class="wh-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ ICONS[a.topic] }}"/></svg>
          <span class="wh-t">{{ NAMES[a.topic] }}</span>
          <b class="wh-a">{% if a.answer == "yes" %}Yes{% elif a.answer == "no" %}No{% else %}Some{% endif %}</b>
          {%- if a.note %}<span class="wh-n">{{ a.note }}</span>{% endif %}
        </li>
        {%- endfor %}
      </ul>
      {%- if site.busy %}
      <div class="wh-today" data-js-only data-wh-today>
        <p class="rs-k">Laptop-friendly today</p>
        <p class="wh-win" data-wh-win>&nbsp;</p>
        <div class="wh-strip" data-wh-strip aria-hidden="true"></div>
        <p class="rs-small">{{ site.busy.basis }}{% if "busy-now" | enabled %} · <a href="#busy">How busy is it now?</a>{% endif %}</p>
      </div>
      {%- endif %}
      {%- if w.rules %}<div class="wh-rules"><p class="rs-k">House rules</p><ul>{% for r in w.rules %}<li>{{ r }}</li>{% endfor %}</ul></div>{% endif %}
    </div>
    {%- if w.photos %}
    <div class="wh-photos">{% for p in w.photos %}<img src="{{ p.src | img }}" width="{{ p.width }}" height="{{ p.height }}" alt="{{ p.alt }}" loading="lazy" decoding="async">{% endfor %}</div>
    {%- endif %}
  </div>
</div></section>
