{#- Key dates to your calendar: the agency's milestones worked back from the date chosen in the brief, listed, and
    saved as one calendar file. Until a date is chosen it says so. -#}
<div class="ev-keys" data-feature="events-key-dates">
  <h2 class="ev-keys-t">Key dates</h2>
  <p class="ev-keys-i" data-ek-intro>{{ site.keyDates.intro or "Choose a date and we'll work back from it." }}</p>
  <ol class="ev-keys-list" data-ek-list></ol>
  <p><button class="ev-alt" type="button" data-ek-save hidden>Add them to your calendar</button></p>
</div>
