{#- An inner page's opening: its name, centred and large; its line beneath. Set `ph` to { title, intro } first. -#}
<header class="ph pp-ph"><div class="wrap">
  <h1 class="pp-ph-t">{{ ph.title | markup | safe }}</h1>
  {%- if ph.intro %}<p class="pp-ph-i">{{ ph.intro }}</p>{% endif %}
</div></header>
