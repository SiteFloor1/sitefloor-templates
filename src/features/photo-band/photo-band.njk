{%- set p = site.photoBand %}
<section class="shot" data-feature="photo-band"{{ "photo-band" | tierAttr | safe }} aria-label="{{ p.kicker }}">
  <picture>
    {%- if p.srcMobile %}<source media="(max-width:700px)" srcset="{{ p.srcMobile | img }}">{% endif %}
    <img src="{{ p.src | img }}" alt="{{ p.alt }}" loading="lazy" decoding="async" width="{{ p.width }}" height="{{ p.height }}">
  </picture>
  <div class="shot-cap wrap"><span class="kick">{{ p.kicker }}</span><p>{{ p.caption }}</p></div>
</section>
