{%- set sec = site.sections.beforeAfter %}
<section id="before-after" class="sec-ba" data-feature="before-after"{{ "before-after" | tierAttr | safe }}><div class="wrap">
  {% include "core/partials/section-head.njk" %}
  <div class="ba-list">
    {%- for p in site.beforeAfter.items %}
    <figure class="ba rv" data-ba>
      <div class="ba-frame">
        <div class="ba-side ba-before" data-ba-before><img src="{{ p.before | img }}" alt="" width="720" height="900" loading="lazy" decoding="async"><span class="ba-lab">{{ p.beforeLabel or "Before" }}</span></div>
        <div class="ba-side ba-after"><img src="{{ p.after | img }}" alt="" width="720" height="900" loading="lazy" decoding="async"><span class="ba-lab">{{ p.afterLabel or "After" }}</span></div>
        <span class="ba-handle" aria-hidden="true"></span>
        <input class="ba-range" type="range" min="0" max="100" value="50" data-ba-range aria-label="Slide to compare {{ (p.beforeLabel or 'before') | lower }} and {{ (p.afterLabel or 'after') | lower }}">
      </div>
      <figcaption><span class="sr-only">{{ p.alt }}. </span>{{ p.caption }}{% if p.by %} · {{ p.by }}{% endif %}</figcaption>
    </figure>
    {%- endfor %}
  </div>
</div></section>
