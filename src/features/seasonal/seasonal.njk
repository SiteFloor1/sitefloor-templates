{#- Seasonal banners. Every season is in the page; the one covering today is shown. The build
    shows whichever was on when the site was built, and seasonal.js corrects it on the day, so a
    season starts and ends on time without a rebuild. -#}
<div class="seasons" data-feature="seasonal">
  {%- for s in site.seasons %}
  <p class="season" data-from="{{ s.from }}" data-to="{{ s.to }}" data-tint="{{ s.tint or '' }}"{% if loop.index0 != build.seasonIndex %} hidden{% endif %}>
    <b>{{ s.name }}</b><span>{{ s.banner }}</span>{% if s.link %}<a href="{{ s.link.href }}">{{ s.link.label }} <span aria-hidden="true">→</span></a>{% endif %}
  </p>
  {%- endfor %}
</div>
