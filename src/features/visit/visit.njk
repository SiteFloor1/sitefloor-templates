{%- set sec = { kicker: site.sections.visit.kicker, title: site.sections.visit.title, intro: site.location.area } %}
<section id="visit" class="sec-visit" data-feature="visit"><div class="wrap">
  {%- if visitHeading == false %}<h2 class="pv-h">Opening hours</h2>{% else %}{% include "core/partials/section-head.njk" %}{% endif %}
  <div class="visit">
    <div class="hours rv" data-hours>
      <p class="now" data-live-status><span class="dot" aria-hidden="true"></span><span data-status-text>Opening hours</span></p>
      <p class="sub" data-status-detail></p>
      <table class="hrs">
        <caption class="sr-only">Opening hours</caption>
        <tbody>
        {%- for row in site.hours | hoursRows %}
          <tr data-day="{{ row.dayIndex }}"><th scope="row">{{ row.day }}</th><td>{{ row.label }}</td></tr>
        {%- endfor %}
        </tbody>
      </table>
      {%- set upcoming = site.hours | upcomingExceptions(build.today) %}
      {%- if upcoming.length %}
      <ul class="exceptions">
        {%- for ex in upcoming %}<li><b>{{ ex.dateLabel }}</b> {{ ex.note or ex.label }}</li>{% endfor %}
      </ul>
      {%- endif %}
    </div>
    <div class="where rv">
      <p class="where-k">Find us</p>
      <p class="where-pc">{{ site.location.postcode }}</p>
      <address>
        <b>{{ site.business.name }}</b>
        {{ site.location.streetAddress }}<br>{{ site.location.locality }} {{ site.location.postcode }}
      </address>
      <a class="btn" href="{{ site.location | directions }}" target="_blank" rel="noopener">Open in Google Maps</a>
    </div>
  </div>
</div></section>
