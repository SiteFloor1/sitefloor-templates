  "process": {
    "steps": [
      {
        "id": "first",
        "name": "First appointment",
        "text": "Cloth, style and measurements. About an hour.",
        "more": "We look at how you stand and how you'll wear it, choose the cloth together and take some thirty measurements. Bring a jacket you like and the shoes you'll wear with the suit."
      },
      {
        "id": "cut",
        "name": "Cut",
        "text": "Your pattern drafted by hand, then the cloth cut.",
        "more": "Your cutter drafts a paper pattern from the measurements and cuts the cloth from it. The pattern is kept in your name for every commission after this one.",
        "photo": {
          "src": "img/photo.webp",
          "width": 300,
          "height": 400,
          "alt": "A cutter drawing on a paper pattern on the cutting table"
        }
      },
      {
        "id": "baste",
        "name": "Baste fitting",
        "text": "The coat held in white thread, to be taken apart.",
        "more": "About four weeks after the first appointment. The coat is loosely sewn so the cutter can mark changes in chalk, unpick it and recut where needed.",
        "photo": {
          "src": "img/photo.webp",
          "width": 300,
          "height": 400,
          "alt": "A coat in progress on a tailor's stand in the workroom, the tailor at his bench behind"
        }
      },
      {
        "id": "forward",
        "name": "Forward fitting",
        "text": "Lining and pockets in; the last changes.",
        "more": "Four to six weeks later. The coat is nearly finished; sleeves, collar and length are settled and the buttons chosen.",
        "photo": {
          "src": "img/photo.webp",
          "width": 300,
          "height": 400,
          "alt": "Four horn buttons in an open hand"
        }
      },
      {
        "id": "finished",
        "name": "Finished",
        "text": "Pressed and ready to collect.",
        "more": "A last try-on, a final press, and the coat is yours. Most first commissions take ten to twelve weeks; later ones are quicker.",
        "photo": {
          "src": "img/photo.webp",
          "width": 300,
          "height": 400,
          "alt": "A finished camel jacket on a hanger by a window"
        }
      }
    ]
  },
