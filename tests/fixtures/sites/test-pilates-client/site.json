  "questions": [
    {
      "topic": "Your first class",
      "q": "I've never done reformer. Where do I start?",
      "a": "Foundation. It's built for a first time, and your teacher shows you the reformer before anything moves.",
      "home": true
    },
    {
      "topic": "Your first class",
      "q": "What do I wear?",
      "a": "Leggings or shorts you can move in, and socks with grips. We sell grip socks at the desk.",
      "home": true
    },
    {
      "topic": "Your first class",
      "q": "How many people are in a class?",
      "a": "Six at most: there are six reformers.",
      "home": true
    },
    {
      "topic": "Your first class",
      "q": "Do I need to be fit or flexible?",
      "a": "No. The springs are set for you, lighter or heavier, and Foundation goes slowly."
    },
    {
      "topic": "Your body",
      "q": "I have an injury. Is it safe?",
      "a": "Tell us before you book. Often a private session first is best, so we can see how you move."
    },
    {
      "topic": "Booking",
      "q": "What if I can't make it?",
      "a": "Cancel twelve hours before and the class goes back on your card. Later than that, it's used."
    },
    {
      "topic": "Booking",
      "q": "What if a class is full?",
      "a": "Tap Waitlist. If a reformer frees up, we message you."
    },
    {
      "topic": "The studio",
      "q": "Are there showers?",
      "a": "One shower and a changing room with lockers, towels and hairdryers."
    },
    {
      "topic": "The studio",
      "q": "Do you sell gift cards?",
      "a": "Yes: class cards, private sessions or any amount. Written by hand."
    }
