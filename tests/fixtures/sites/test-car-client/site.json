  "aftercare": {
    "services": [
      {
        "id": "tint",
        "name": "Window tint",
        "steps": [
          {
            "day": 0,
            "title": "Leave the windows up",
            "body": "Keep the tinted windows closed so the film can bond to the glass."
          },
          {
            "day": 4,
            "title": "Windows down again",
            "body": "You can use the windows normally now. Small water bubbles can take a couple of weeks to clear in cold weather."
          },
          {
            "day": 14,
            "title": "Clean the inside",
            "body": "Clean the inside of the glass with a soft cloth and an ammonia-free cleaner. No blades or scrapers."
          },
          {
            "day": 30,
            "title": "Check the edges",
            "body": "Any lifting edge or bubble that hasn't cleared: send us a photo and we'll fix it under warranty."
          }
        ]
      },
      {
        "id": "wrap",
        "name": "Wrap",
        "steps": [
          {
            "day": 0,
            "title": "No washing for now",
            "body": "Keep the car out of washes and pressure washers while the film settles."
          },
          {
            "day": 7,
            "title": "First hand wash",
            "body": "Hand wash with a pH-neutral shampoo. Keep a pressure washer at least 30cm from edges."
          },
          {
            "day": 30,
            "title": "Look at the edges",
            "body": "Check corners and door edges. Anything lifting, message us and we'll book you in."
          },
          {
            "day": 182,
            "title": "Six-month check",
            "body": "Pop in for a free look-over and a top-up of the wrap sealant."
          }
        ]
      },
      {
        "id": "ppf",
        "name": "PPF",
        "steps": [
          {
            "day": 0,
            "title": "Leave it alone",
            "body": "Small haze or water spots under the film are normal and clear as it dries."
          },
          {
            "day": 7,
            "title": "First wash",
            "body": "Hand wash only, pH-neutral shampoo, no polish on the film."
          },
          {
            "day": 30,
            "title": "Haze gone?",
            "body": "Any haze left after a month, send us a photo."
          },
          {
            "day": 182,
            "title": "Six-month check",
            "body": "Free inspection of edges and a fresh coat of film sealant."
          }
        ]
      },
      {
        "id": "ceramic",
        "name": "Ceramic coating",
        "steps": [
          {
            "day": 0,
            "title": "Keep it dry",
            "body": "Keep the car dry and out of the rain if you can; the coating is still curing."
          },
          {
            "day": 7,
            "title": "First wash",
            "body": "Two-bucket hand wash with a pH-neutral shampoo. No automatic washes."
          },
          {
            "day": 91,
            "title": "Maintenance wash",
            "body": "Book a maintenance wash so we can check the coating is beading."
          },
          {
            "day": 365,
            "title": "Yearly check",
            "body": "Annual inspection to keep the 3-year cover valid."
          }
        ]
      }
    ]
  },
