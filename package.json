{
  "name": "sitefloor-templates",
  "version": "0.1.0",
  "private": true,
  "description": "Sitefloor website kit: shared core, features, looks, demo sites and client sites.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:all": "node scripts/build.js --all --fixtures",
    "serve": "node scripts/serve.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "budget": "node scripts/size-budget.js",
    "rules": "node scripts/rules-check.js",
    "docs": "node scripts/docs-index.js",
    "demo-links": "node scripts/demo-links.js",
    "pages": "node scripts/pages.js --out _site",
    "seasons": "node scripts/seasons.js",
    "release": "node scripts/release.js",
    "new-client": "node scripts/new-client.js",
    "check": "npm run lint && npm run rules && npm run typecheck && npm run test:unit && npm run build:all && npm run budget && npm run test:e2e"
  },
